{
  "name": "ayakashi-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ayakashi/web dev",
    "build": "pnpm --filter @ayakashi/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ayakashi/db generate",
    "db:migrate": "pnpm --filter @ayakashi/db migrate",
    "db:studio": "pnpm --filter @ayakashi/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
