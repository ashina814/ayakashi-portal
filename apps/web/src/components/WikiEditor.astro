---
/**
 * Tiptap エディタを mount する Astro コンポーネント。
 *
 * Props:
 *   initialContent     : 初期 Tiptap JSON 文字列（新規ならからの doc）
 *   apiEndpoint        : 保存先 POST URL
 *   redirectOnSuccess  : 保存成功時に遷移する URL
 *   expectedRevisionId : 楽観ロック用の現在 revision id（新規は null）
 *
 * ツールバーは editor-toolbar.ts のデータから描画。
 * 各ボタンには日本語ラベルとツールチップ（ショートカット付き）が付く。
 * 右端の ?  ヘルプボタンを押すと、機能一覧 + ショートカット表 + ガイドへのリンクを出すダイアログが開く。
 */

import {
  TOOLBAR_GROUPS,
  SHORTCUT_HINTS,
} from "../lib/wiki/editor-toolbar";

interface Props {
  initialContent: string;
  apiEndpoint: string;
  redirectOnSuccess: string;
  expectedRevisionId: string | null;
}

const {
  initialContent,
  apiEndpoint,
  redirectOnSuccess,
  expectedRevisionId,
} = Astro.props;
---

<div
  class="we-root"
  data-api={apiEndpoint}
  data-redirect={redirectOnSuccess}
  data-expected-revision={expectedRevisionId ?? ""}
>
  <div class="we-toolbar" role="toolbar" aria-label="編集ツール">
    {TOOLBAR_GROUPS.map((group) => (
      <div class="we-group" aria-label={group.name}>
        <span class="we-glabel">{group.name}</span>
        {group.items.map((item) => (
          <button
            type="button"
            class="we-btn"
            title={item.title}
            data-cmd={item.cmd}
            data-insert={item.insert}
            style={item.color ? `--swatch:${item.color}` : undefined}
          >
            {item.color && <span class="we-swatch" aria-hidden="true"></span>}
            <span class="we-btn-label">{item.label}</span>
          </button>
        ))}
      </div>
    ))}

    <div class="we-spacer"></div>
    <span class="we-status" data-status>変更なし</span>
    <button
      type="button"
      class="we-btn we-btn-help"
      data-help-open
      title="使い方を見る"
      aria-label="使い方を見る"
    >？ヘルプ</button>
    <button
      type="button"
      class="we-btn we-btn-primary"
      data-action="save"
    >封ずる</button>
  </div>

  <div class="we-area" data-editor></div>

  <!-- ヘルプダイアログ -->
  <dialog class="we-help" data-help-dialog aria-labelledby="we-help-title">
    <header class="we-help-head">
      <h2 id="we-help-title">編集ツールの使い方</h2>
      <button
        type="button"
        class="we-btn we-btn-ghost"
        data-help-close
        aria-label="閉じる"
      >閉じる</button>
    </header>

    <section class="we-help-section">
      <h3>道具一覧</h3>
      <p class="we-help-lede">
        ツールバーの各ボタンを押すと、現在のカーソル位置に対して動作します。
        範囲選択してから装飾系を押すと、その範囲だけが対象になります。
      </p>
      <table class="we-help-table">
        <tbody>
          {TOOLBAR_GROUPS.flatMap((g) =>
            g.items.map((it) => (
              <tr>
                <th>{it.label}</th>
                <td>{it.title}</td>
              </tr>
            )),
          )}
        </tbody>
      </table>
    </section>

    <section class="we-help-section">
      <h3>キーボードショートカット</h3>
      <table class="we-help-table">
        <tbody>
          {SHORTCUT_HINTS.map((s) => (
            <tr>
              <th class="we-help-kbd">{s.keys}</th>
              <td>{s.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="we-help-section">
      <h3>もっと知りたい</h3>
      <p>
        <a href="/wiki/guide" target="_blank" rel="noopener">
          ▸ 編集ガイド（実例付き）を別タブで開く
        </a>
      </p>
      <p class="we-help-lede">
        実物のサンプルを見て、「編む」を押せば中身がそのまま見られます。
      </p>
    </section>
  </dialog>
</div>

<template data-initial>{initialContent}</template>

<script>
  import { Editor } from "@tiptap/core";
  import StarterKit from "@tiptap/starter-kit";
  import Link from "@tiptap/extension-link";
  import { Callout, Toggle, StatusChip } from "../lib/wiki/editor";
  import { bindToolbar, bindHelpDialog } from "../lib/wiki/editor-bind";

  const root = document.querySelector<HTMLElement>(".we-root");
  if (!root) throw new Error("WikiEditor root not found");

  const target = root.querySelector<HTMLElement>("[data-editor]")!;
  const statusEl = root.querySelector<HTMLElement>("[data-status]")!;
  const tplEl = document.querySelector<HTMLTemplateElement>("[data-initial]")!;

  const apiEndpoint = root.dataset.api!;
  const redirectUrl = root.dataset.redirect!;
  let expectedRevisionId: string | null = root.dataset.expectedRevision || null;

  let initial: any = { type: "doc", content: [{ type: "paragraph" }] };
  try {
    const raw = tplEl.content.textContent?.trim();
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && parsed.type === "doc") initial = parsed;
    }
  } catch {
    // 旧プレーンテキストはデフォルトの空 doc で開く
  }

  let dirty = false;
  function markDirty(d: boolean) {
    dirty = d;
    statusEl.textContent = d ? "未保存" : "保存済み";
    statusEl.dataset.dirty = d ? "1" : "0";
  }

  const editor = new Editor({
    element: target,
    extensions: [
      StarterKit.configure({ heading: { levels: [2, 3, 4] } }),
      Link.configure({ openOnClick: false, autolink: true }),
      Callout,
      Toggle,
      StatusChip,
    ],
    content: initial,
    onUpdate() {
      markDirty(true);
    },
  });

  markDirty(false);

  bindToolbar(root, editor);
  bindHelpDialog(root);

  const saveBtn = root.querySelector<HTMLButtonElement>("[data-action=save]")!;
  saveBtn.addEventListener("click", async () => {
    saveBtn.disabled = true;
    statusEl.textContent = "保存中…";
    try {
      const content = JSON.stringify(editor.getJSON());
      const res = await fetch(apiEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content, expectedRevisionId }),
      });
      if (res.status === 409) {
        const data = await res.json().catch(() => ({}));
        statusEl.textContent = "競合: 他の編集が先に保存されました";
        expectedRevisionId = data.currentRevisionId ?? expectedRevisionId;
        return;
      }
      if (!res.ok) {
        statusEl.textContent = `保存失敗: ${res.status} ${await res.text()}`;
        return;
      }
      window.location.assign(redirectUrl);
    } finally {
      saveBtn.disabled = false;
    }
  });

  window.addEventListener("beforeunload", (e) => {
    if (dirty) {
      e.preventDefault();
      e.returnValue = "";
    }
  });
</script>

<style>
  .we-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .we-toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background: var(--bg-surface);
    backdrop-filter: blur(8px);
  }

  .we-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    align-items: center;
    padding-right: 0.65rem;
    padding-left: 0.4rem;
    border-right: 1px solid rgba(184, 149, 64, 0.15);
  }
  .we-group:last-of-type { border-right: none; }
  .we-spacer { flex: 1; min-width: 0; }

  /* グループラベル — D版風の縦書きラベル */
  .we-glabel {
    font-family: "Shippori Mincho B1", serif;
    font-size: 0.66rem;
    letter-spacing: 0.3em;
    padding-left: 0.3em;
    color: var(--text-muted);
    margin-right: 0.5rem;
    align-self: center;
  }

  .we-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0.3rem 0.65rem;
    font-family: "Shippori Mincho B1", serif;
    font-size: 0.82rem;
    cursor: pointer;
    line-height: 1.2;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  /* 色見本ドット — callout/chip 系の識別補助 */
  .we-swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 1px;
    background: var(--swatch, transparent);
    flex: 0 0 auto;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .we-btn:hover {
    background: rgba(184, 149, 64, 0.08);
    color: var(--color-gold-100);
  }
  .we-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .we-btn-help {
    border-color: rgba(184, 149, 64, 0.3);
    color: var(--color-gold-300);
  }
  .we-btn-help:hover {
    border-color: var(--color-gold-500);
  }
  .we-btn-ghost {
    color: var(--text-secondary);
  }
  .we-btn-ghost:hover {
    color: var(--color-gold-100);
  }
  .we-btn-primary {
    background: var(--color-gold-700);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
    padding: 0.4rem 1.1rem;
    font-size: 0.88rem;
  }
  .we-btn-primary:hover {
    background: var(--color-gold-500);
    color: var(--color-ink-950);
  }

  .we-status {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .we-status[data-dirty="1"] { color: var(--color-gold-300); }

  .we-area {
    border: 1px solid var(--border-base);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    min-height: 24rem;
    background: rgba(10, 5, 9, 0.3);
  }

  .we-area :global(.ProseMirror) {
    outline: none;
    min-height: 22rem;
    line-height: 1.85;
    font-size: 0.98rem;
  }
  .we-area :global(.ProseMirror:focus) { outline: none; }
  .we-area :global(.ProseMirror p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder);
    color: var(--text-muted);
    pointer-events: none;
    float: left;
  }

  .we-area :global(h2) {
    font-size: 1.45rem;
    letter-spacing: 0.08em;
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.2);
  }
  .we-area :global(h3) {
    font-size: 1.15rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--color-gold-300);
  }
  .we-area :global(blockquote) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border-left: 3px solid var(--color-gold-700);
    background: rgba(184, 149, 64, 0.04);
    color: var(--text-secondary);
    font-style: italic;
  }
  .we-area :global(code) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
  }
  .we-area :global(pre) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .we-area :global(ul),
  .we-area :global(ol) { padding-left: 1.5rem; margin: 0.75rem 0; }
  .we-area :global(hr) {
    border: none;
    border-top: 1px solid rgba(184, 149, 64, 0.2);
    margin: 1.5rem 0;
  }
  .we-area :global(.cl) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    border-left: 3px solid var(--color-gold-500);
    background: rgba(184, 149, 64, 0.06);
  }
  .we-area :global(.cl[data-variant="warning"]) { border-left-color: var(--color-gold-500); }
  .we-area :global(.cl[data-variant="danger"]) {
    border-left-color: var(--color-crimson-500);
    background: rgba(193, 40, 58, 0.08);
  }
  .we-area :global(.cl[data-variant="success"]) {
    border-left-color: var(--color-moss-500);
    background: rgba(107, 138, 78, 0.08);
  }
  .we-area :global(.cl[data-variant="info"]) {
    border-left-color: var(--color-mist-glow);
    background: rgba(184, 224, 255, 0.06);
  }
  .we-area :global(.tg) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border-base);
    border-radius: 6px;
    background: rgba(10, 5, 9, 0.3);
  }
  .we-area :global(.tg > summary) {
    cursor: pointer;
    color: var(--color-gold-300);
    padding-bottom: 0.4rem;
  }
  .we-area :global(.chip) {
    display: inline-block;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.78rem;
    font-weight: 600;
    margin: 0 0.2rem;
  }
  .we-area :global(.chip[data-variant="ok"]) { color: var(--color-moss-500); }
  .we-area :global(.chip[data-variant="ng"]) { color: var(--color-crimson-300); }
  .we-area :global(.chip[data-variant="warn"]) { color: var(--color-gold-500); }

  /* ── ヘルプダイアログ ───────────────── */
  .we-help {
    width: min(640px, 92vw);
    max-height: 86dvh;
    border: 1px solid var(--border-base);
    border-radius: 12px;
    background: var(--bg-surface);
    color: var(--text-primary);
    padding: 0;
  }
  .we-help::backdrop {
    background: rgba(10, 5, 9, 0.7);
    backdrop-filter: blur(4px);
  }

  .we-help-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-base);
    position: sticky;
    top: 0;
    background: var(--bg-surface);
  }
  .we-help-head h2 {
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .we-help-section {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.1);
  }
  .we-help-section:last-of-type { border-bottom: none; }
  .we-help-section h3 {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--color-gold-300);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .we-help-lede {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 0.85rem;
    line-height: 1.7;
  }

  .we-help-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .we-help-table th,
  .we-help-table td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.08);
    vertical-align: top;
  }
  .we-help-table th {
    color: var(--color-gold-100);
    font-weight: 500;
    white-space: nowrap;
    width: 12rem;
  }
  .we-help-table td {
    color: var(--text-secondary);
  }
  .we-help-kbd {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
  }
</style>
