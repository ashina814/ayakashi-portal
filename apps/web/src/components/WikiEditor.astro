---
/**
 * Tiptap エディタを mount する Astro コンポーネント。
 *
 * Props:
 *   initialContent : 初期表示する Tiptap JSON 文字列（新規作成なら空）
 *   apiEndpoint    : 保存先 (POST) URL
 *   redirectOnSuccess : 保存成功時にリダイレクトする URL
 *   expectedRevisionId : 楽観ロック用の現在の revision id（新規ならnull）
 *
 * クライアント側スクリプトは Astro の <script> （type=module）で同梱され、
 * Vite が Tiptap を bundle してくれる。Editor のロードは編集ページのみなので
 * 閲覧ページのバンドルサイズには影響しない。
 */

interface Props {
  initialContent: string;
  apiEndpoint: string;
  redirectOnSuccess: string;
  expectedRevisionId: string | null;
}

const {
  initialContent,
  apiEndpoint,
  redirectOnSuccess,
  expectedRevisionId,
} = Astro.props;
---

<div
  class="we-root"
  data-api={apiEndpoint}
  data-redirect={redirectOnSuccess}
  data-expected-revision={expectedRevisionId ?? ""}
>
  <div class="we-toolbar" role="toolbar" aria-label="編集ツール">
    <div class="we-group">
      <button type="button" class="we-btn" data-cmd="h2" title="見出し2">H2</button>
      <button type="button" class="we-btn" data-cmd="h3" title="見出し3">H3</button>
      <button type="button" class="we-btn" data-cmd="paragraph" title="段落">¶</button>
    </div>
    <div class="we-group">
      <button type="button" class="we-btn" data-cmd="bold" title="太字"><strong>B</strong></button>
      <button type="button" class="we-btn" data-cmd="italic" title="斜体"><em>I</em></button>
      <button type="button" class="we-btn" data-cmd="strike" title="打消"><s>S</s></button>
      <button type="button" class="we-btn" data-cmd="code" title="インラインコード">{`</>`}</button>
    </div>
    <div class="we-group">
      <button type="button" class="we-btn" data-cmd="bulletList" title="箇条書き">•</button>
      <button type="button" class="we-btn" data-cmd="orderedList" title="番号付き">1.</button>
      <button type="button" class="we-btn" data-cmd="blockquote" title="引用">❝</button>
      <button type="button" class="we-btn" data-cmd="codeBlock" title="コードブロック">{`{}`}</button>
      <button type="button" class="we-btn" data-cmd="hr" title="区切り線">—</button>
      <button type="button" class="we-btn" data-cmd="link" title="リンク">🔗</button>
    </div>
    <div class="we-group we-group-block">
      <button type="button" class="we-btn" data-insert="callout:note" title="覚書">📓 Note</button>
      <button type="button" class="we-btn" data-insert="callout:warning" title="注意">⚠ Warn</button>
      <button type="button" class="we-btn" data-insert="callout:danger" title="危険">🚫 Danger</button>
      <button type="button" class="we-btn" data-insert="callout:success" title="成功">✓ OK</button>
      <button type="button" class="we-btn" data-insert="toggle" title="折りたたみ">▶ 折</button>
    </div>
    <div class="we-group">
      <button type="button" class="we-btn" data-insert="chip:ok" title="○">○</button>
      <button type="button" class="we-btn" data-insert="chip:ng" title="×">×</button>
      <button type="button" class="we-btn" data-insert="chip:warn" title="△">△</button>
    </div>
    <div class="we-spacer"></div>
    <span class="we-status" data-status>変更なし</span>
    <button type="button" class="we-btn we-btn-primary" data-action="save">封ずる</button>
  </div>

  <div class="we-area" data-editor></div>
</div>

<template data-initial>{initialContent}</template>

<script>
  import { Editor } from "@tiptap/core";
  import StarterKit from "@tiptap/starter-kit";
  import Link from "@tiptap/extension-link";
  import {
    Callout,
    Toggle,
    StatusChip,
  } from "../lib/wiki/editor";

  const root = document.querySelector<HTMLElement>(".we-root");
  if (!root) throw new Error("WikiEditor root not found");

  const target = root.querySelector<HTMLElement>("[data-editor]")!;
  const statusEl = root.querySelector<HTMLElement>("[data-status]")!;
  const tplEl = document.querySelector<HTMLTemplateElement>("[data-initial]")!;

  const apiEndpoint = root.dataset.api!;
  const redirectUrl = root.dataset.redirect!;
  let expectedRevisionId: string | null = root.dataset.expectedRevision || null;

  let initial: any = { type: "doc", content: [{ type: "paragraph" }] };
  try {
    const raw = tplEl.content.textContent?.trim();
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && parsed.type === "doc") initial = parsed;
    }
  } catch {
    // 旧データなどパース失敗時はデフォルトの空 doc を使う
  }

  let dirty = false;
  function markDirty(d: boolean) {
    dirty = d;
    statusEl.textContent = d ? "未保存" : "保存済み";
    statusEl.dataset.dirty = d ? "1" : "0";
  }

  const editor = new Editor({
    element: target,
    extensions: [
      StarterKit.configure({ heading: { levels: [2, 3, 4] } }),
      Link.configure({ openOnClick: false, autolink: true }),
      Callout,
      Toggle,
      StatusChip,
    ],
    content: initial,
    onUpdate() {
      markDirty(true);
    },
  });

  markDirty(false);

  // ── ツールバー ────────────────────────────
  for (const btn of root.querySelectorAll<HTMLButtonElement>(".we-btn[data-cmd]")) {
    btn.addEventListener("click", () => {
      const cmd = btn.dataset.cmd!;
      const chain = editor.chain().focus();
      switch (cmd) {
        case "h2": chain.toggleHeading({ level: 2 }).run(); break;
        case "h3": chain.toggleHeading({ level: 3 }).run(); break;
        case "paragraph": chain.setParagraph().run(); break;
        case "bold": chain.toggleBold().run(); break;
        case "italic": chain.toggleItalic().run(); break;
        case "strike": chain.toggleStrike().run(); break;
        case "code": chain.toggleCode().run(); break;
        case "bulletList": chain.toggleBulletList().run(); break;
        case "orderedList": chain.toggleOrderedList().run(); break;
        case "blockquote": chain.toggleBlockquote().run(); break;
        case "codeBlock": chain.toggleCodeBlock().run(); break;
        case "hr": chain.setHorizontalRule().run(); break;
        case "link": {
          const url = window.prompt("リンクURL", "https://");
          if (url) chain.setLink({ href: url }).run();
          else chain.unsetLink().run();
          break;
        }
      }
    });
  }

  for (const btn of root.querySelectorAll<HTMLButtonElement>(".we-btn[data-insert]")) {
    btn.addEventListener("click", () => {
      const ins = btn.dataset.insert!;
      const chain = editor.chain().focus();
      if (ins.startsWith("callout:")) {
        const variant = ins.split(":")[1];
        chain.insertContent({
          type: "callout",
          attrs: { variant, title: variant === "note" ? "覚書" : variant === "warning" ? "注意" : variant === "danger" ? "危険" : variant === "success" ? "成功" : null },
          content: [{ type: "paragraph", content: [{ type: "text", text: "本文" }] }],
        }).run();
      } else if (ins === "toggle") {
        chain.insertContent({
          type: "toggle",
          attrs: { summary: "クリックで開く" },
          content: [{ type: "paragraph", content: [{ type: "text", text: "中身" }] }],
        }).run();
      } else if (ins.startsWith("chip:")) {
        const variant = ins.split(":")[1];
        chain.insertContent({
          type: "statusChip",
          attrs: { variant, label: variant === "ok" ? "○" : variant === "ng" ? "×" : "△" },
        }).run();
      }
    });
  }

  // ── 保存 ────────────────────────────────
  const saveBtn = root.querySelector<HTMLButtonElement>("[data-action=save]")!;
  saveBtn.addEventListener("click", async () => {
    saveBtn.disabled = true;
    statusEl.textContent = "保存中…";
    try {
      const content = JSON.stringify(editor.getJSON());
      const res = await fetch(apiEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content, expectedRevisionId }),
      });
      if (res.status === 409) {
        const data = await res.json().catch(() => ({}));
        statusEl.textContent = "競合: 他の編集が先に保存されました";
        expectedRevisionId = data.currentRevisionId ?? expectedRevisionId;
        return;
      }
      if (!res.ok) {
        const text = await res.text();
        statusEl.textContent = `保存失敗: ${res.status} ${text}`;
        return;
      }
      window.location.assign(redirectUrl);
    } finally {
      saveBtn.disabled = false;
    }
  });

  // ── 離脱時の確認 ─────────────────────────
  window.addEventListener("beforeunload", (e) => {
    if (dirty) {
      e.preventDefault();
      e.returnValue = "";
    }
  });
</script>

<style>
  .we-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .we-toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background: var(--bg-surface);
    backdrop-filter: blur(8px);
  }

  .we-group {
    display: flex;
    gap: 0.2rem;
    align-items: center;
    padding-right: 0.4rem;
    border-right: 1px solid rgba(184, 149, 64, 0.15);
  }
  .we-group:last-of-type { border-right: none; }
  .we-spacer { flex: 1; min-width: 0; }

  .we-btn {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    line-height: 1.2;
    min-width: 1.8rem;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .we-btn:hover {
    background: rgba(184, 149, 64, 0.08);
    color: var(--color-gold-100);
  }
  .we-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .we-btn-primary {
    background: var(--color-gold-700);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
    padding: 0.35rem 1rem;
  }
  .we-btn-primary:hover {
    background: var(--color-gold-500);
    color: var(--color-ink-950);
  }

  .we-status {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .we-status[data-dirty="1"] { color: var(--color-gold-300); }

  .we-area {
    border: 1px solid var(--border-base);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    min-height: 24rem;
    background: rgba(10, 5, 9, 0.3);
  }

  /* Tiptap が target 要素内に .ProseMirror として class を付ける */
  .we-area :global(.ProseMirror) {
    outline: none;
    min-height: 22rem;
    line-height: 1.85;
    font-size: 0.98rem;
  }
  .we-area :global(.ProseMirror:focus) { outline: none; }
  .we-area :global(.ProseMirror p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder);
    color: var(--text-muted);
    pointer-events: none;
    float: left;
  }

  /* 編集中も読み手と同じ表示で WYSIWYG にする（簡易、display 側 .prose と整合） */
  .we-area :global(h2) {
    font-size: 1.45rem;
    letter-spacing: 0.08em;
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.2);
  }
  .we-area :global(h3) {
    font-size: 1.15rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--color-gold-300);
  }
  .we-area :global(blockquote) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border-left: 3px solid var(--color-gold-700);
    background: rgba(184, 149, 64, 0.04);
    color: var(--text-secondary);
    font-style: italic;
  }
  .we-area :global(code) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
  }
  .we-area :global(pre) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .we-area :global(ul),
  .we-area :global(ol) { padding-left: 1.5rem; margin: 0.75rem 0; }
  .we-area :global(hr) {
    border: none;
    border-top: 1px solid rgba(184, 149, 64, 0.2);
    margin: 1.5rem 0;
  }
  .we-area :global(.cl) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    border-left: 3px solid var(--color-gold-500);
    background: rgba(184, 149, 64, 0.06);
  }
  .we-area :global(.cl[data-variant="warning"]) { border-left-color: var(--color-gold-500); }
  .we-area :global(.cl[data-variant="danger"]) {
    border-left-color: var(--color-crimson-500);
    background: rgba(193, 40, 58, 0.08);
  }
  .we-area :global(.cl[data-variant="success"]) {
    border-left-color: var(--color-moss-500);
    background: rgba(107, 138, 78, 0.08);
  }
  .we-area :global(.cl[data-variant="info"]) {
    border-left-color: var(--color-mist-glow);
    background: rgba(184, 224, 255, 0.06);
  }
  .we-area :global(.tg) {
    margin: 1rem 0;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border-base);
    border-radius: 6px;
    background: rgba(10, 5, 9, 0.3);
  }
  .we-area :global(.tg > summary) {
    cursor: pointer;
    color: var(--color-gold-300);
    padding-bottom: 0.4rem;
  }
  .we-area :global(.chip) {
    display: inline-block;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.78rem;
    font-weight: 600;
    margin: 0 0.2rem;
  }
  .we-area :global(.chip[data-variant="ok"]) { color: var(--color-moss-500); }
  .we-area :global(.chip[data-variant="ng"]) { color: var(--color-crimson-300); }
  .we-area :global(.chip[data-variant="warn"]) { color: var(--color-gold-500); }
</style>
