---
/**
 * TopBar — 幽世ポータル Wiki 用の固定上部ヘッダー。
 *
 * 左: 「幽世」ロゴ + パンくず
 * 右: 検索ボタン (⌘K) + 任意のアクションスロット + ユーザーリンク
 *
 * パンくずは Array<{ title, href? }> で受ける。href 無しは現在位置。
 */

interface Crumb {
  title: string;
  href?: string;
}

interface Props {
  breadcrumbs?: Crumb[];
  userName?: string;
}

const { breadcrumbs = [], userName } = Astro.props;
---

<header class="topbar">
  <a class="topbar-logo" href="/" title="ハブへ">幽世</a>
  {breadcrumbs.length > 0 && (
    <>
      <span class="topbar-divider" aria-hidden="true"></span>
      <nav class="topbar-bread" aria-label="パンくず">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span class="topbar-sep">／</span>}
            {b.href ? (
              <a href={b.href}>{b.title}</a>
            ) : (
              <span class="topbar-here">{b.title}</span>
            )}
          </>
        ))}
      </nav>
    </>
  )}
  <div class="topbar-spacer"></div>
  <button
    type="button"
    class="topbar-search"
    onclick="window.__openWikiSearch && window.__openWikiSearch()"
    aria-label="検索を開く"
  >
    <span aria-hidden="true">⌕</span>
    <span class="topbar-search-label">幽世を辿る…</span>
    <span class="topbar-kbd">⌘K</span>
  </button>
  <slot name="actions" />
  <a class="topbar-user" href="/me" title={userName ?? "マイページ"}>
    <span class="topbar-avatar" aria-hidden="true">月</span>
  </a>
  <a class="topbar-logout" href="/api/auth/signout" title="退散">退散</a>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 56px;
    padding: 0 24px;
    background: rgba(10, 5, 9, 0.78);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--color-ink-800);
    font-family: "Noto Sans JP", sans-serif;
  }

  .topbar-logo {
    font-family: "Yuji Syuku", serif;
    font-size: 20px;
    letter-spacing: 0.4em;
    padding-left: 0.4em;
    color: var(--color-gold-300);
    text-shadow: 0 0 18px rgba(184, 224, 255, 0.25);
  }
  .topbar-logo:hover { color: var(--color-gold-100); }

  .topbar-divider {
    width: 1px;
    height: 22px;
    background: var(--border-base);
  }

  .topbar-bread {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    min-width: 0;
    flex-wrap: wrap;
  }
  .topbar-bread a {
    color: var(--text-muted);
  }
  .topbar-bread a:hover { color: var(--text-secondary); }
  .topbar-sep { opacity: 0.4; }
  .topbar-here {
    color: var(--color-gold-100);
    font-family: "Shippori Mincho B1", serif;
  }

  .topbar-spacer { flex: 1; }

  .topbar-search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 12px;
    min-width: 200px;
    background: rgba(20, 9, 15, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 2px;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .topbar-search:hover {
    border-color: var(--color-ink-600);
    color: var(--text-secondary);
  }
  .topbar-search-label { flex: 1; text-align: left; }
  .topbar-kbd {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border-base);
    border-radius: 2px;
    color: var(--text-muted);
  }

  .topbar-user {
    display: flex;
    align-items: center;
  }
  .topbar-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-ink-700), var(--color-ink-900));
    border: 1px solid var(--color-gold-700);
    display: grid;
    place-items: center;
    font-family: "Yuji Syuku", serif;
    font-size: 14px;
    color: var(--color-gold-300);
  }
  .topbar-user:hover .topbar-avatar { border-color: var(--color-gold-500); }

  .topbar-logout {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.15em;
  }
  .topbar-logout:hover { color: var(--color-gold-300); }

  @media (max-width: 720px) {
    .topbar { gap: 10px; padding: 0 14px; }
    .topbar-search-label { display: none; }
    .topbar-search { min-width: 0; }
    .topbar-bread { font-size: 11px; }
  }
</style>
