---
/**
 * ログイン画面ステージ (LUXEL — 星の幻想ファンタジー)
 *
 * docs/login-handoff/ のプロトタイプ (HTML/CSS/JS) を Astro 1 枚に移植したもの。
 * 群青の夜空に「光の核」が浮かび、アストロラーベ風メダリオン (ENTER) が主役 CTA。
 * クリックで核が収縮→反発→開花し白光が満ちる演出の後、Discord OAuth へ遷移する。
 *
 * 認証連携: enter() の白フラッシュ最中 (~3.1s) に submitAuth() を呼ぶ。
 * submitAuth は login.astro の #auth-form (CSRF 付き POST) を submit する。
 * フォームが無い場合は OAUTH_URL に GET 直行。
 *
 * メダリオン SVG の目盛り環・星座バンドは JS で生成 (handoff README 準拠)。
 * 残り (ベゼル / ティンパヌム / レテ / 中心星 / ラベル) は inline。
 */
---

<div class="loader" id="loader" aria-hidden="true">
  <div class="loader-line"></div>
  <div class="loader-text">
    aligning the stars<span class="loader-dots"></span>
  </div>
  <div class="loader-spark s1"></div>
  <div class="loader-spark s2"></div>
  <div class="loader-spark s3"></div>
</div>

<div class="stage" id="stage" data-screen-label="LUXEL login">
  <div class="bg-base"></div>
  <div class="nebula"></div>
  <div class="milkyway"></div>
  <div class="starfield" id="starfield"></div>
  <div class="grain"></div>

  <div class="light-scan"></div>

  <!-- HERO: radiant star core -->
  <div class="world-star" id="worldStar">
    <div class="orbit-ring r1">
      <div class="orbit-spin"><div class="planet"></div></div>
    </div>
    <div class="orbit-ring r2">
      <div class="orbit-spin rev"><div class="planet"></div></div>
    </div>
    <div class="core">
      <div class="rays fine"></div>
      <div class="rays coarse"></div>
      <div class="halo"></div>
      <div class="corona-tex"></div>
      <div class="ghosts">
        <div class="ghost g1"></div>
        <div class="ghost g2"></div>
        <div class="ghost g3"></div>
        <div class="ghost g4"></div>
      </div>
      <div class="spikes">
        <div class="spike h"></div>
        <div class="spike v"></div>
        <div class="spike d1"></div>
        <div class="spike d2"></div>
        <div class="spike s1"></div>
        <div class="spike s2"></div>
        <div class="spike s3"></div>
        <div class="spike s4"></div>
      </div>
      <div class="rim"></div>
      <div class="nucleus"></div>
    </div>
  </div>

  <!-- faint constellation, upper-right -->
  <div class="constellation" aria-hidden="true">
    <svg viewBox="0 0 220 184">
      <g stroke="rgba(159,188,255,0.30)" stroke-width="0.7" fill="none">
        <polyline points="20,40 70,20 120,52 168,30 200,70 150,96 96,80 58,120 24,104" />
      </g>
      <g fill="#cdddff">
        <circle cx="20" cy="40" r="1.8" /><circle cx="70" cy="20" r="2.4" />
        <circle cx="120" cy="52" r="1.7" /><circle cx="168" cy="30" r="2" />
        <circle cx="200" cy="70" r="1.7" /><circle cx="150" cy="96" r="2.2" />
        <circle cx="96" cy="80" r="1.7" /><circle cx="58" cy="120" r="2" />
        <circle cx="24" cy="104" r="1.7" />
      </g>
      <text x="4" y="178" font-family="JetBrains Mono, monospace" font-size="8"
            letter-spacing="3" fill="rgba(159,188,255,0.36)">VELA · α–ι</text>
    </svg>
  </div>

  <div class="vignette"></div>

  <!-- corner frame marks -->
  <div class="frame" aria-hidden="true">
    <span class="fm tl"></span>
    <span class="fm tr"></span>
    <span class="fm bl"></span>
    <span class="fm br"></span>
    <span class="coord c-tl">R.A 18ʰ 36ᵐ · LUXEL</span>
  </div>

  <!-- server name -->
  <div class="header">
    <div class="rule"></div>
    <h1>LUXEL</h1>
    <div class="rule lower"></div>
    <div class="sub">lumen in tenebris</div>
  </div>

  <div id="stardust-container"></div>

  <!-- CTA: astrolabe medallion -->
  <div class="medallion-wrap">
    <span class="med-float">
      <button class="medallion" id="medallion" type="button" aria-label="Enter — sign in with Discord">
        <svg viewBox="0 0 168 168">
          <defs>
            <radialGradient id="med-fill" cx="50%" cy="40%" r="62%">
              <stop offset="0" stop-color="#1a2858" />
              <stop offset="0.55" stop-color="#101a40" />
              <stop offset="1" stop-color="#070c20" />
            </radialGradient>
            <linearGradient id="med-bezel" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#cdddff" />
              <stop offset="0.5" stop-color="#5878c8" />
              <stop offset="1" stop-color="#1b285e" />
            </linearGradient>
            <radialGradient id="med-center" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.4" stop-color="#eef4ff" />
              <stop offset="0.75" stop-color="#9fbcff" />
              <stop offset="1" stop-color="transparent" />
            </radialGradient>
            <path id="enterArc" d="M46.75 131.67 A60.5 60.5 0 0 1 121.25 131.67" />
          </defs>

          <circle cx="84" cy="84" r="81" fill="none" stroke="url(#med-bezel)" stroke-width="2.4" />
          <circle cx="84" cy="84" r="78" fill="url(#med-fill)" stroke="#1b285e" stroke-width="0.8" />
          <circle cx="84" cy="84" r="75" fill="none" stroke="#2f47a8" stroke-width="0.5" opacity="0.6" />
          <circle cx="84" cy="84" r="58" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.5" />

          <!-- degree ring (JS-generated) -->
          <g id="med-degring"></g>

          <!-- constellation band (JS-generated, slow rotate) -->
          <g class="ring-rot" id="med-constband"></g>

          <!-- tympanum -->
          <g>
            <circle cx="84" cy="84" r="54" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.42" />
            <circle cx="84" cy="84" r="45" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.38" />
            <circle cx="84" cy="84" r="36" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.34" />
            <circle cx="84" cy="84" r="27" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.30" />
            <circle cx="84" cy="84" r="18" fill="none" stroke="#2f47a8" stroke-width="0.6" opacity="0.26" />
            <circle cx="84" cy="70" r="22" fill="none" stroke="#7aa2ff" stroke-width="0.6" opacity="0.4" />
            <line x1="29" y1="84" x2="139" y2="84" stroke="#2f47a8" stroke-width="0.5" opacity="0.3" />
            <line x1="84" y1="29" x2="84" y2="139" stroke="#2f47a8" stroke-width="0.5" opacity="0.3" />
          </g>

          <!-- rete (counter-rotating star-pointers) -->
          <g class="ring-rot rev">
            <path d="M86.95 67.26 Q85.57 54.04 92.34 36.73 Q92.77 55.31 86.95 67.26 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="92.34" cy="36.73" r="1.4" fill="#d7e3ff" />
            <path d="M99.97 78.19 Q110.73 70.38 129.11 67.58 Q113.23 77.25 99.97 78.19 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="129.11" cy="67.58" r="1.4" fill="#d7e3ff" />
            <path d="M97.02 94.93 Q109.16 100.34 120.77 114.85 Q104.46 105.94 97.02 94.93 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="120.77" cy="114.85" r="1.4" fill="#d7e3ff" />
            <path d="M70.98 94.93 Q63.54 105.94 47.23 114.85 Q58.84 100.34 70.98 94.93 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="47.23" cy="114.85" r="1.4" fill="#d7e3ff" />
            <path d="M68.03 78.19 Q54.77 77.25 38.89 67.58 Q57.27 70.38 68.03 78.19 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="38.89" cy="67.58" r="1.4" fill="#d7e3ff" />
            <path d="M81.05 67.26 Q75.23 55.31 75.66 36.73 Q82.43 54.04 81.05 67.26 Z" fill="none" stroke="#9fbcff" stroke-width="0.7" opacity="0.45" />
            <circle cx="75.66" cy="36.73" r="1.4" fill="#d7e3ff" />
            <circle cx="84" cy="84" r="50" fill="none" stroke="#7aa2ff" stroke-width="0.5" opacity="0.32" />
          </g>

          <!-- center star -->
          <circle cx="84" cy="78" r="14" fill="url(#med-center)" opacity="0.7" />
          <g transform="translate(84 78)">
            <path d="M0,-21 L4,-4 L21,0 L4,4 L0,21 L-4,4 L-21,0 L-4,-4 Z" fill="#eef4ff" opacity="0.96" />
            <path d="M0,-11 L2.4,-2.4 L11,0 L2.4,2.4 L0,11 L-2.4,2.4 L-11,0 L-2.4,-2.4 Z" fill="#ffffff" />
            <circle cx="0" cy="0" r="2.5" fill="#fff" />
          </g>

          <!-- ENTER label -->
          <path d="M43.52 128.96 A60.5 60.5 0 0 1 124.48 128.96" fill="none" stroke="#070c20" stroke-width="13" stroke-linecap="round" opacity="0.85" />
          <text class="med-label" font-family="Cinzel, serif" font-weight="600" font-size="11" letter-spacing="3" fill="#eef4ff">
            <textPath href="#enterArc" startOffset="51.6%" text-anchor="middle">ENTER</textPath>
          </text>
        </svg>
      </button>
    </span>
    <div class="medallion-hint">
      <svg class="dc" viewBox="0 0 24 24" fill="#8ea2c6" aria-hidden="true">
        <path d="M20.3 4.6A19 19 0 0 0 15.6 3l-.2.5a17 17 0 0 1 4.1 1.3 15.7 15.7 0 0 0-15 0A17 17 0 0 1 8.6 3.5L8.4 3a19 19 0 0 0-4.7 1.6C1 9.7.2 14.6.6 19.5a19 19 0 0 0 5.8 3l.7-1.1a12 12 0 0 1-1.9-.9l.5-.4a13.6 13.6 0 0 0 11.6 0l.5.4c-.6.4-1.2.7-1.9.9l.7 1.1a19 19 0 0 0 5.8-3c.5-5.7-.8-10.6-3.8-14.9ZM8.5 16.4c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Zm7 0c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3Z" />
      </svg>
      <span>Sign in with Discord</span>
    </div>
  </div>

  <a class="chrome-skip" href="#" id="skip">skip the light →</a>
  <button class="chrome-mute" id="mute" type="button">♪ MUTE</button>

  <div class="sky-mark">
    <div class="moon"><div class="shadow" id="moonShadow"></div></div>
    <div class="info">
      <div class="phase" id="moonPhase">Full Moon</div>
      <div class="meta">LUXEL · v0.1.0</div>
    </div>
  </div>
</div>

<div class="kime-bloom" id="kimeBloom" aria-hidden="true"></div>
<div class="cursor-halo" id="cursorHalo"></div>
<div class="flash" id="flash"></div>

<style is:global>
  /* ───────────────────────── LUXEL — login stage
   * docs/login-handoff/ のプロトタイプ CSS (luxel.css + luxel-2.css) を統合。
   * 御札テーマの global.css とは別パレット (--void / --star)。login ページ専用。
   * JS が動的生成する .star / .stardust にも効かせるため is:global。
   * ─────────────────────────────────────── */
  :root {
    --void-950: #04060f;
    --void-900: #070b1e;
    --void-850: #0a1026;
    --void-800: #0c1330;
    --indigo-800: #14215a;
    --indigo-700: #1b2a6b;
    --indigo-500: #2f47a8;
    --star-500: #4d77e6;
    --star-400: #7aa2ff;
    --star-300: #9fbcff;
    --star-200: #b9d0ff;
    --star-100: #d7e3ff;
    --star-050: #eef4ff;
    --warm-200: #ffe6c2;
    --silver-500: #8ea2c6;
    --silver-700: #5a6c91;
  }

  html, body {
    background: var(--void-950);
    color: var(--star-100);
    font-family: "Cormorant Garamond", "Times New Roman", serif;
  }

  /* stage: cinematic forward push on click */
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 52%;
    transition: transform 5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stage.is-entering { transform: scale(1.05); filter: brightness(0.85); }

  /* background washes */
  .bg-base {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 12%, rgba(47, 71, 168, 0.30) 0%, transparent 60%),
      radial-gradient(ellipse 90% 60% at 50% 100%, rgba(20, 33, 90, 0.45) 0%, transparent 72%),
      radial-gradient(ellipse 120% 90% at 50% 50%, var(--void-900) 0%, var(--void-950) 78%);
  }

  .nebula {
    position: absolute;
    inset: -10%;
    pointer-events: none;
    opacity: 0.55;
    mix-blend-mode: screen;
    background:
      radial-gradient(ellipse 34% 30% at 30% 38%, rgba(77, 119, 230, 0.30) 0%, transparent 70%),
      radial-gradient(ellipse 30% 26% at 72% 30%, rgba(122, 162, 255, 0.18) 0%, transparent 70%),
      radial-gradient(ellipse 40% 34% at 60% 72%, rgba(47, 71, 168, 0.22) 0%, transparent 70%);
    filter: blur(8px);
    animation: nebulaDrift 40s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes nebulaDrift {
    from { transform: translate(-1.5%, -1%) scale(1.02); }
    to   { transform: translate(1.5%, 1.5%) scale(1.06); }
  }

  .milkyway {
    position: absolute;
    inset: -20%;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: screen;
    background: linear-gradient(118deg,
      transparent 38%,
      rgba(159, 188, 255, 0.06) 46%,
      rgba(215, 227, 255, 0.10) 50%,
      rgba(159, 188, 255, 0.06) 54%,
      transparent 62%);
    filter: blur(3px);
  }

  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.06;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  /* starfield */
  .starfield {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--star-050);
    animation: twinkle var(--tw, 4s) ease-in-out var(--td, 0s) infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: var(--base, 0.5); transform: scale(1); }
    50%      { opacity: calc(var(--base, 0.5) * 0.2); transform: scale(0.7); }
  }

  /* HERO: radiant star core */
  .world-star {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    margin-top: -13vh;
  }
  .core {
    position: relative;
    width: clamp(250px, 39vh, 440px);
    height: clamp(250px, 39vh, 440px);
    animation: coreBreath 11s ease-in-out infinite;
    will-change: transform, filter;
  }
  @keyframes coreBreath {
    0%, 100% { transform: scale(1);    filter: brightness(1); }
    50%      { transform: scale(1.045); filter: brightness(1.14); }
  }
  .core .halo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(238, 244, 255, 0.95) 0%,
      rgba(214, 226, 255, 0.62) 6%,
      rgba(185, 208, 255, 0.42) 11%,
      rgba(150, 184, 255, 0.30) 17%,
      rgba(122, 162, 255, 0.22) 24%,
      rgba(86, 124, 220, 0.16) 33%,
      rgba(47, 71, 168, 0.12) 44%,
      rgba(30, 50, 130, 0.06) 56%,
      transparent 68%);
    animation: haloPulse 7s ease-in-out infinite;
  }
  @keyframes haloPulse {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }

  .core .rays {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    mix-blend-mode: screen;
    -webkit-mask: radial-gradient(circle, transparent 9%, #000 22%, #000 40%, transparent 64%);
            mask: radial-gradient(circle, transparent 9%, #000 22%, #000 40%, transparent 64%);
  }
  .core .rays.fine {
    background: repeating-conic-gradient(from 0deg,
      transparent 0deg 2.1deg,
      rgba(200, 218, 255, 0.05) 2.3deg 2.55deg,
      transparent 2.75deg 4.4deg);
    animation: raySpin 120s linear infinite;
  }
  .core .rays.coarse {
    background: repeating-conic-gradient(from 6deg,
      transparent 0deg 10deg,
      rgba(215, 227, 255, 0.07) 10.6deg 11.4deg,
      transparent 12deg 20deg);
    animation: raySpin 200s linear infinite reverse;
    opacity: 0.8;
  }
  @keyframes raySpin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

  .core .corona-tex {
    position: absolute;
    inset: -4%;
    border-radius: 50%;
    mix-blend-mode: screen;
    opacity: 0.5;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='f'><feTurbulence type='fractalNoise' baseFrequency='0.024' numOctaves='3' seed='7'/><feColorMatrix type='matrix' values='0 0 0 0 0.78  0 0 0 0 0.85  0 0 0 0 1  0 0 0 0.9 0'/></filter><rect width='100%25' height='100%25' filter='url(%23f)'/></svg>");
    background-size: cover;
    -webkit-mask: radial-gradient(circle, transparent 13%, #000 26%, transparent 56%);
            mask: radial-gradient(circle, transparent 13%, #000 26%, transparent 56%);
    animation: coronaChurn 18s ease-in-out infinite alternate;
  }
  @keyframes coronaChurn {
    from { transform: rotate(0deg) scale(1); opacity: 0.4; }
    to   { transform: rotate(8deg) scale(1.05); opacity: 0.6; }
  }

  .core .rim {
    position: absolute;
    top: 50%; left: 50%;
    width: 27%; height: 27%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    box-shadow:
      0 0 0 1px rgba(185, 208, 255, 0.35),
      0 0 0 2.5px rgba(122, 162, 255, 0.12),
      inset 0 0 16px rgba(215, 227, 255, 0.4);
    animation: rimPulse 7s ease-in-out infinite;
  }
  @keyframes rimPulse {
    0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
    50%      { opacity: 1;   transform: translate(-50%, -50%) scale(1.06); }
  }

  .core .ghosts { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; }
  .core .ghost {
    position: absolute;
    top: 50%; left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .core .ghost.g1 { width: 7%;  height: 7%;  margin: -19% 0 0 19%; background: radial-gradient(circle, rgba(185,208,255,0.45), transparent 70%); }
  .core .ghost.g2 { width: 4%;  height: 4%;  margin: -11% 0 0 11%; background: radial-gradient(circle, rgba(255,230,194,0.40), transparent 70%); }
  .core .ghost.g3 { width: 11%; height: 11%; margin: 24% 0 0 -24%; background: radial-gradient(circle, rgba(122,162,255,0.28), transparent 72%); }
  .core .ghost.g4 { width: 5%;  height: 5%;  margin: 14% 0 0 -14%; background: radial-gradient(circle, rgba(214,226,255,0.35), transparent 70%); }

  .core .nucleus {
    position: absolute;
    top: 50%; left: 50%;
    width: 16%; height: 16%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, #ffffff 0%, var(--star-050) 40%, rgba(185,208,255,0.6) 70%, transparent 100%);
    box-shadow: 0 0 60px 18px rgba(215, 227, 255, 0.55),
                0 0 130px 40px rgba(122, 162, 255, 0.30);
  }

  .core .spikes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: spikeShimmer 6s ease-in-out infinite;
  }
  .core .spike {
    position: absolute;
    top: 50%; left: 50%;
    transform-origin: center;
    background: linear-gradient(90deg,
      transparent,
      rgba(215, 227, 255, 0.0) 14%,
      rgba(215, 227, 255, 0.9) 50%,
      rgba(215, 227, 255, 0.0) 86%,
      transparent);
    border-radius: 50%;
  }
  .core .spike.h { width: 168%; height: 2.2px; transform: translate(-50%, -50%) rotate(0deg); box-shadow: 0 0 8px rgba(185, 208, 255, 0.55); }
  .core .spike.v { width: 142%; height: 2.2px; transform: translate(-50%, -50%) rotate(90deg); box-shadow: 0 0 8px rgba(185, 208, 255, 0.55); }
  .core .spike.d1 { width: 104%; height: 1.5px; transform: translate(-50%, -50%) rotate(45deg); opacity: 0.55; }
  .core .spike.d2 { width: 104%; height: 1.5px; transform: translate(-50%, -50%) rotate(-45deg); opacity: 0.55; }
  .core .spike.s1 { width: 72%; height: 1px; transform: translate(-50%, -50%) rotate(22deg); opacity: 0.3; }
  .core .spike.s2 { width: 72%; height: 1px; transform: translate(-50%, -50%) rotate(-22deg); opacity: 0.3; }
  .core .spike.s3 { width: 64%; height: 1px; transform: translate(-50%, -50%) rotate(68deg); opacity: 0.26; }
  .core .spike.s4 { width: 64%; height: 1px; transform: translate(-50%, -50%) rotate(-68deg); opacity: 0.26; }
  @keyframes spikeShimmer {
    0%, 100% { opacity: 0.85; transform: rotate(0deg) scale(1); }
    50%      { opacity: 1;    transform: rotate(0.5deg) scale(1.03); }
  }

  .orbit-ring {
    position: absolute;
    top: 50%; left: 50%;
    width: clamp(360px, 54vh, 600px);
    height: clamp(360px, 54vh, 600px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(122, 162, 255, 0.14);
    pointer-events: none;
  }
  .orbit-ring.r1::after {
    content: "";
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    border: 1px solid rgba(122, 162, 255, 0.07);
  }
  .orbit-ring.r1::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg,
      rgba(159, 188, 255, 0.32) 0deg 0.35deg,
      transparent 0.35deg 7.5deg);
    -webkit-mask: radial-gradient(circle, transparent calc(50% - 5px), #000 calc(50% - 5px));
            mask: radial-gradient(circle, transparent calc(50% - 5px), #000 calc(50% - 5px));
  }
  .orbit-ring.r2 {
    width: clamp(540px, 82vh, 940px);
    height: clamp(540px, 82vh, 940px);
    border-color: rgba(122, 162, 255, 0.05);
  }
  .orbit-ring .planet {
    position: absolute;
    top: -2.5px; left: 50%;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--star-200);
    box-shadow: 0 0 12px 2px rgba(185, 208, 255, 0.7);
  }
  .orbit-spin { animation: orbitSpin 90s linear infinite; transform-origin: center; }
  .orbit-spin.rev { animation-duration: 140s; animation-direction: reverse; }
  @keyframes orbitSpin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

  /* constellation overlay */
  .constellation {
    position: absolute;
    top: 11%; right: 7.5%;
    width: 210px; height: 178px;
    pointer-events: none;
    opacity: 0;
    animation: constIn 2.4s 3.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .constellation svg { width: 100%; height: 100%; overflow: visible; }
  @keyframes constIn {
    from { opacity: 0; filter: blur(6px); }
    to   { opacity: 0.7; filter: blur(0); }
  }

  /* header */
  .header {
    position: absolute;
    top: 58px; left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    animation: headerIn 2s 1.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    z-index: 6;
  }
  .header .rule {
    width: 120px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--star-400) 50%, transparent);
  }
  .header .rule.lower { width: 64px; opacity: 0.7; }
  .header h1 {
    margin: 0;
    font-family: "Cinzel", serif;
    font-size: 52px;
    font-weight: 600;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
    color: var(--star-050);
    text-shadow: 0 0 30px rgba(122, 162, 255, 0.55), 0 0 70px rgba(77, 119, 230, 0.30);
  }
  .header .sub {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
    color: var(--silver-500);
    white-space: nowrap;
  }
  @keyframes headerIn {
    from { opacity: 0; filter: blur(10px); transform: translate(-50%, -8px); }
    to   { opacity: 1; filter: blur(0);    transform: translate(-50%, 0); }
  }

  /* stardust */
  .stardust {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--star-100);
    box-shadow: 0 0 14px 3px rgba(185, 208, 255, 0.6);
    pointer-events: none;
    opacity: 0;
    animation: dustRise var(--dur, 8s) ease-in-out var(--delay, 0s) infinite;
  }
  @keyframes dustRise {
    0%   { opacity: 0; transform: translate(0, 0) scale(0.6); }
    15%  { opacity: 1; }
    50%  { transform: translate(var(--sway, 20px), -50px) scale(1); }
    85%  { opacity: 0.7; }
    100% { opacity: 0; transform: translate(calc(var(--sway, 20px) * -1), -150px) scale(0.4); }
  }

  /* vignette */
  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 90% 72% at 50% 50%,
      transparent 42%,
      rgba(4, 6, 15, 0.55) 86%,
      rgba(4, 6, 15, 0.88) 100%);
    z-index: 10;
  }
  .vignette::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 0% 0%, rgba(4, 6, 15, 0.6) 0%, transparent 35%),
      radial-gradient(circle at 100% 0%, rgba(4, 6, 15, 0.6) 0%, transparent 35%),
      radial-gradient(circle at 0% 100%, rgba(4, 6, 15, 0.72) 0%, transparent 42%),
      radial-gradient(circle at 100% 100%, rgba(4, 6, 15, 0.72) 0%, transparent 42%);
  }

  /* corner frame */
  .frame {
    position: absolute;
    inset: 26px 30px;
    pointer-events: none;
    z-index: 8;
    animation: frameIn 2.4s 2.8s ease-out both;
  }
  @keyframes frameIn { from { opacity: 0; } to { opacity: 1; } }
  .frame .fm {
    position: absolute;
    width: 22px; height: 22px;
    border: 1px solid rgba(159, 188, 255, 0.28);
  }
  .frame .fm.tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
  .frame .fm.tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
  .frame .fm.bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
  .frame .fm.br { bottom: 0; right: 0; border-left: 0; border-top: 0; }
  .frame .coord {
    position: absolute;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    color: rgba(159, 188, 255, 0.32);
  }
  .frame .coord.c-tl { top: 1px; left: 32px; }

  /* CTA medallion */
  .medallion-wrap {
    position: absolute;
    bottom: 8.5%; left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    animation: medIn 2s 2.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    z-index: 6;
  }
  @keyframes medIn {
    from { opacity: 0; transform: translate(-50%, 36px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }
  .medallion {
    position: relative;
    width: 168px; height: 168px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    filter: drop-shadow(0 0 22px rgba(122, 162, 255, 0.28));
    transform: scale(1);
    transition: filter 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, filter;
  }
  .med-float {
    display: block;
    animation: medFloat 5.5s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes medFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-7px); }
  }
  .medallion svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .medallion .ring-rot { transform-origin: 84px 84px; animation: ringRot 60s linear infinite; }
  .medallion .ring-rot.rev { animation-duration: 88s; animation-direction: reverse; }
  @keyframes ringRot { from { transform: rotate(0); } to { transform: rotate(360deg); } }
  .medallion:hover {
    filter: drop-shadow(0 0 40px rgba(122, 162, 255, 0.6)) drop-shadow(0 0 16px rgba(238, 244, 255, 0.5));
    transform: scale(1.045);
  }
  .medallion:active { transform: scale(1.015); transition-duration: 0.18s; }
  .medallion:focus-visible { outline: 2px solid var(--star-400); outline-offset: 8px; border-radius: 50%; }
  .medallion .med-label {
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.5em;
    fill: var(--star-050);
    transition: fill 0.4s;
  }
  .medallion:hover .med-label { fill: #ffffff; }

  .medallion-hint {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 14px;
    letter-spacing: 0.22em;
    color: var(--silver-500);
    opacity: 0.85;
  }
  .medallion-hint .dc { width: 16px; height: 16px; opacity: 0.8; }

  /* chrome */
  .chrome-skip {
    position: absolute;
    top: 30px; right: 36px;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0.18em;
    color: rgba(215, 227, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s;
    z-index: 7;
  }
  .chrome-skip:hover { color: var(--star-050); }
  .chrome-mute {
    position: absolute;
    bottom: 26px; right: 36px;
    background: none;
    border: 1px solid rgba(215, 227, 255, 0.18);
    color: rgba(215, 227, 255, 0.55);
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    padding: 8px 14px;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 7;
  }
  .chrome-mute:hover { color: var(--star-050); border-color: var(--star-400); }

  /* sky-mark: moon phase */
  .sky-mark {
    position: absolute;
    bottom: 28px; left: 36px;
    display: flex;
    align-items: center;
    gap: 14px;
    z-index: 5;
  }
  .sky-mark .moon {
    position: relative;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--star-100);
    box-shadow: 0 0 16px rgba(185, 208, 255, 0.4);
    overflow: hidden;
    flex: none;
  }
  .sky-mark .moon .shadow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--void-850);
  }
  .sky-mark .info { display: flex; flex-direction: column; gap: 2px; }
  .sky-mark .phase {
    font-family: "Cinzel", serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--star-200);
  }
  .sky-mark .meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(215, 227, 255, 0.4);
  }

  /* light scan */
  .light-scan {
    position: absolute;
    left: -10%; right: -10%; top: -12%;
    height: 10%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(122, 162, 255, 0.12) 50%, transparent);
    filter: blur(22px);
    animation: lightScan 20s linear infinite;
    z-index: 4;
    mix-blend-mode: screen;
  }
  @keyframes lightScan {
    from { transform: translateY(0); }
    to   { transform: translateY(1200%); }
  }

  /* cursor halo */
  .cursor-halo {
    position: fixed;
    top: 0; left: 0;
    width: 60px; height: 60px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 90;
    background: radial-gradient(circle,
      rgba(122, 162, 255, 0.22) 0%,
      rgba(122, 162, 255, 0.07) 35%,
      transparent 70%);
    transform: translate(-50%, -50%);
    transition: width 0.3s ease-out, height 0.3s ease-out, background 0.3s;
    opacity: 0;
  }
  .cursor-halo.visible { opacity: 1; }
  .cursor-halo.is-near {
    width: 130px; height: 130px;
    background: radial-gradient(circle,
      rgba(185, 208, 255, 0.38) 0%,
      rgba(122, 162, 255, 0.12) 40%,
      transparent 70%);
  }

  /* ENDING SEQUENCE */
  .world-star.is-awakening { z-index: 92; }
  .world-star.is-awakening .core {
    animation: coreAwaken 3.2s cubic-bezier(0.5, 0, 0.25, 1) forwards;
  }
  @keyframes coreAwaken {
    0%   { transform: scale(1);    filter: brightness(1) drop-shadow(0 0 0 transparent); }
    8%   { transform: scale(0.62); filter: brightness(0.7); }
    11%  { transform: scale(0.6);  filter: brightness(0.65); }
    17%  { transform: scale(1.12); filter: brightness(2.4) drop-shadow(0 0 120px rgba(238,244,255,0.9)); }
    48%  { transform: scale(2.0);  filter: brightness(2.6) drop-shadow(0 0 160px rgba(215,227,255,0.8)); }
    82%  { transform: scale(3.2);  filter: brightness(3.2) drop-shadow(0 0 320px rgba(255,255,255,1)); }
    100% { transform: scale(4.6);  filter: brightness(4) drop-shadow(0 0 600px #fff); opacity: 1; }
  }
  .world-star.is-awakening .nucleus {
    animation: nucleusBlaze 3.2s cubic-bezier(0.5, 0, 0.25, 1) forwards;
  }
  @keyframes nucleusBlaze {
    0%, 11% { width: 16%; height: 16%; }
    17%     { width: 30%; height: 30%; }
    100%    { width: 100%; height: 100%; background: radial-gradient(circle, #fff 0%, #fff 70%, transparent 100%); }
  }
  .medallion.is-vanishing { animation: medVanish 1.0s ease-in forwards; }
  @keyframes medVanish {
    from { opacity: 1; filter: drop-shadow(0 0 18px rgba(122,162,255,0.3)); }
    to   { opacity: 0; filter: drop-shadow(0 0 60px rgba(238,244,255,0.8)); }
  }
  .stage.is-fading-out { animation: stageFadeOut 1.6s ease-in forwards; }
  @keyframes stageFadeOut {
    from { filter: brightness(1) blur(0); }
    to   { filter: brightness(0.32) blur(3px); }
  }
  .stage.is-fading-out .world-star.is-awakening { filter: brightness(1) !important; }

  .kime-bloom {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 90;
    opacity: 0;
    background: radial-gradient(circle at 50% 50%,
      rgba(255, 255, 255, 1) 0%,
      rgba(238, 244, 255, 0.9) 14%,
      rgba(122, 162, 255, 0.5) 36%,
      transparent 66%);
    transform: scale(0.2);
    transform-origin: 50% 50%;
  }
  .kime-bloom.active { animation: kimeBloom 2.4s cubic-bezier(0.45, 0, 0.2, 1) forwards; }
  @keyframes kimeBloom {
    0%   { opacity: 0;    transform: scale(0.15); }
    30%  { opacity: 0.4;  transform: scale(0.6); }
    70%  { opacity: 0.95; transform: scale(1.6); }
    100% { opacity: 1;    transform: scale(3.0); }
  }

  .flash {
    position: fixed;
    inset: 0;
    background: #eef4ff;
    opacity: 0;
    pointer-events: none;
    z-index: 100;
  }
  .flash.active { animation: flashKime 2.0s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
  @keyframes flashKime {
    0%  { opacity: 0; }
    70% { opacity: 0.9; }
    100%{ opacity: 1; }
  }

  /* loader */
  .loader {
    position: fixed;
    inset: 0;
    background: var(--void-950);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 40px;
    animation: loaderOut 1.2s 3.2s cubic-bezier(0.5, 0, 0.5, 1) forwards;
    pointer-events: none;
  }
  .loader-line {
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--star-400) 50%, transparent);
    animation: lineSweep 1.4s 0.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .loader-text {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.4em;
    padding-left: 0.4em;
    color: var(--silver-500);
    opacity: 0;
    animation: loaderTextIn 1.2s 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .loader-dots { display: inline-block; width: 24px; text-align: left; }
  .loader-dots::after { content: ""; animation: dots 1.4s steps(4, end) 1.5s infinite; }
  .loader-spark {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--star-200);
    box-shadow: 0 0 12px 2px rgba(185, 208, 255, 0.7);
    opacity: 0;
    animation: sparkBlink 2.4s ease-in-out 1.6s infinite;
  }
  .loader-spark.s1 { left: 40%; top: 47%; animation-delay: 1.6s; }
  .loader-spark.s2 { left: 60%; top: 51%; animation-delay: 1.9s; }
  .loader-spark.s3 { left: 50%; top: 60%; animation-delay: 2.2s; }
  @keyframes lineSweep { 0% { width: 0; opacity: 0; } 20% { opacity: 1; } 100% { width: 260px; opacity: 1; } }
  @keyframes loaderTextIn {
    from { opacity: 0; filter: blur(8px); transform: translateY(6px); }
    to   { opacity: 1; filter: blur(0);   transform: translateY(0); }
  }
  @keyframes sparkBlink { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes dots {
    0%  { content: ""; }
    25% { content: "·"; }
    50% { content: "··"; }
    75% { content: "···"; }
    100%{ content: ""; }
  }
  @keyframes loaderOut { from { opacity: 1; } to { opacity: 0; visibility: hidden; } }
  /* 2回目以降の訪問はローダーを出さない (JS が付与) */
  .loader.skip { animation: none; opacity: 0; visibility: hidden; }

  /* low-spec: 重い周辺演出を止める (JS が html.low-spec を付与) */
  html.low-spec .light-scan,
  html.low-spec .nebula,
  html.low-spec .corona-tex { animation: none; }
  html.low-spec .nebula { opacity: 0.35; }

  /* reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .core, .halo, .nucleus, .spikes, .nebula, .stardust, .medallion,
    .orbit-spin, .ring-rot, .light-scan, .star, .loader-spark { animation: none !important; }
    .header, .medallion-wrap, .poem, .constellation { animation: none !important; opacity: 1 !important; }
    .loader { animation-delay: 0s !important; animation-duration: 0.4s !important; }
  }
</style>

<script>
  // ─── production OAuth wiring ───────────────────────────
  // login.astro が #auth-form (CSRF 付き POST /api/auth/signin/discord) を用意する。
  // フォームが無ければ OAUTH_URL に GET 直行 (フォールバック)。
  const OAUTH_URL = "/api/auth/discord";
  function submitAuth(): void {
    const form = document.getElementById("auth-form") as HTMLFormElement | null;
    if (form) {
      form.submit();
    } else {
      window.location.href = OAUTH_URL;
    }
  }

  // ─── visited / low-spec / reduced-motion ──────────────
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const nav = navigator as Navigator & { deviceMemory?: number };
  const lowSpec =
    (nav.hardwareConcurrency ?? 8) < 4 || (nav.deviceMemory ?? 8) < 4;
  if (lowSpec) document.documentElement.classList.add("low-spec");

  const seenBefore = localStorage.getItem("luxel-visited") === "1";
  if (seenBefore) {
    document.getElementById("loader")?.classList.add("skip");
  } else {
    localStorage.setItem("luxel-visited", "1");
  }

  const STAR_COUNT = lowSpec ? 70 : 180;
  const DUST_COUNT = lowSpec ? 10 : 26;

  // ─── starfield ────────────────────────────────────────
  (function buildStarfield() {
    const field = document.getElementById("starfield");
    if (!field) return;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < STAR_COUNT; i++) {
      const s = document.createElement("div");
      s.className = "star";
      const size =
        Math.random() < 0.85 ? 0.8 + Math.random() * 1.4 : 2 + Math.random() * 1.8;
      const base = 0.25 + Math.random() * 0.6;
      s.style.cssText = `left:${Math.random() * 100}%;top:${Math.random() * 100}%;width:${size}px;height:${size}px;--base:${base.toFixed(2)};--tw:${(3 + Math.random() * 5).toFixed(1)}s;--td:${(-Math.random() * 6).toFixed(1)}s;`;
      if (Math.random() < 0.06) s.style.background = "var(--warm-200)";
      frag.appendChild(s);
    }
    field.appendChild(frag);
  })();

  // ─── stardust motes ───────────────────────────────────
  (function buildStardust() {
    const c = document.getElementById("stardust-container");
    if (!c) return;
    for (let i = 0; i < DUST_COUNT; i++) {
      const f = document.createElement("div");
      f.className = "stardust";
      const dur = 6 + Math.random() * 5;
      f.style.cssText = `left:${Math.random() * 100}%;top:${35 + Math.random() * 60}%;width:${(2 + Math.random() * 3).toFixed(1)}px;height:${(2 + Math.random() * 3).toFixed(1)}px;--dur:${dur.toFixed(1)}s;--delay:${(-Math.random() * dur).toFixed(1)}s;--sway:${((Math.random() - 0.5) * 70).toFixed(0)}px;`;
      c.appendChild(f);
    }
  })();

  // ─── medallion engraving (degree ring + constellation band) ──
  // handoff README 準拠: 目盛りと星座バンドはプログラム生成。
  (function buildEngraving() {
    const SVGNS = "http://www.w3.org/2000/svg";
    const cx = 84,
      cy = 84;
    const pt = (r: number, deg: number): [number, number] => {
      const a = (deg * Math.PI) / 180;
      return [cx + r * Math.sin(a), cy - r * Math.cos(a)];
    };

    // degree ring: 120 ticks every 3°, majors every 30°
    const deg = document.getElementById("med-degring");
    if (deg) {
      for (let i = 0; i < 120; i++) {
        const angle = i * 3;
        const major = i % 10 === 0;
        const [x1, y1] = pt(major ? 66.5 : 70.5, angle);
        const [x2, y2] = pt(74, angle);
        const line = document.createElementNS(SVGNS, "line");
        line.setAttribute("x1", x1.toFixed(2));
        line.setAttribute("y1", y1.toFixed(2));
        line.setAttribute("x2", x2.toFixed(2));
        line.setAttribute("y2", y2.toFixed(2));
        line.setAttribute("stroke", major ? "#9fbcff" : "#7aa2ff");
        line.setAttribute("stroke-width", major ? "1" : "0.5");
        line.setAttribute("opacity", major ? "0.65" : "0.3");
        deg.appendChild(line);
      }
    }

    // constellation band: 12 four-point stars at r=60, every 30° offset 15°
    const band = document.getElementById("med-constband");
    if (band) {
      for (let i = 0; i < 12; i++) {
        const angle = 15 + i * 30;
        const [x, y] = pt(60, angle);
        const big = i % 3 === 0;
        const s = big ? 3 : 2;
        const t = (s * 0.28).toFixed(2);
        const path = document.createElementNS(SVGNS, "path");
        path.setAttribute(
          "d",
          `M0,-${s} L${t},-${t} L${s},0 L${t},${t} L0,${s} L-${t},${t} L-${s},0 L-${t},-${t} Z`,
        );
        path.setAttribute("transform", `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
        path.setAttribute("fill", "#b9d0ff");
        path.setAttribute("opacity", big ? "0.8" : "0.55");
        band.appendChild(path);
      }
    }
  })();

  // ─── refs ─────────────────────────────────────────────
  const stage = document.getElementById("stage")!;
  const flash = document.getElementById("flash")!;
  const medallion = document.getElementById("medallion")!;
  const worldStar = document.getElementById("worldStar")!;
  const starfield = document.getElementById("starfield")!;
  const cursorHalo = document.getElementById("cursorHalo")!;
  const kimeBloom = document.getElementById("kimeBloom")!;

  // ─── converge stardust into the medallion on click ────
  function convergeStardust() {
    const r = medallion.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    const cy = r.top + r.height / 2;
    document.querySelectorAll<HTMLElement>(".stardust").forEach((f) => {
      const fr = f.getBoundingClientRect();
      const dx = cx - (fr.left + fr.width / 2);
      const dy = cy - (fr.top + fr.height / 2);
      f.style.animation = "none";
      f.animate(
        [
          { transform: "translate(0,0) scale(1)", opacity: 0.9 },
          { transform: `translate(${dx * 0.9}px, ${dy * 0.9}px) scale(2.2)`, opacity: 1, offset: 0.85 },
          { transform: `translate(${dx}px, ${dy}px) scale(0)`, opacity: 0 },
        ],
        {
          duration: 700 + Math.random() * 400,
          delay: Math.random() * 250,
          easing: "cubic-bezier(0.5, 0, 0.75, 0)",
          fill: "forwards",
        },
      );
    });
  }

  // ─── ENTER sequence ───────────────────────────────────
  let entering = false;
  function enter() {
    if (entering) return;
    entering = true;

    worldStar.classList.add("is-awakening");
    if (!muted) playChime();

    setTimeout(() => {
      convergeStardust();
      medallion.classList.add("is-vanishing");
    }, 300);

    setTimeout(() => { if (!muted) playThump(); }, 520);
    setTimeout(() => stage.classList.add("is-fading-out"), 700);

    setTimeout(() => {
      kimeBloom.classList.add("active");
      flash.classList.add("active");
      if (!muted) playKime();
    }, 2000);

    // 白フラッシュが満ちる頃 (~3.1s) に Discord OAuth へ。
    // 遷移は白の下で起こるので画面の切り替わりが見えない。
    setTimeout(() => submitAuth(), 3100);
  }

  // ─── audio engine (Web Audio API) ─────────────────────
  let audioCtx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let ambientStarted = false;
  let muted = localStorage.getItem("luxel-muted") !== "0";

  function initAudio() {
    if (audioCtx) return;
    const Ctor =
      window.AudioContext ||
      (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
    audioCtx = new Ctor();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = muted ? 0 : 0.55;
    masterGain.connect(audioCtx.destination);
  }
  function ensureAudio() {
    initAudio();
    if (audioCtx && audioCtx.state === "suspended") void audioCtx.resume();
  }

  function playChime() {
    ensureAudio();
    if (!audioCtx || !masterGain) return;
    const now = audioCtx.currentTime;
    const fund = 1046.5;
    [
      { f: fund, g: 0.5, d: 2.4 },
      { f: fund * 1.5, g: 0.3, d: 1.8 },
      { f: fund * 2.0, g: 0.22, d: 1.4 },
      { f: fund * 3.0, g: 0.12, d: 1.0 },
      { f: fund * 4.0, g: 0.07, d: 0.7 },
    ].forEach((h, i) => {
      const osc = audioCtx!.createOscillator();
      osc.type = "sine";
      osc.frequency.value = h.f;
      const g = audioCtx!.createGain();
      const t = now + i * 0.012;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(h.g * 0.35, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0005, t + h.d);
      osc.connect(g).connect(masterGain!);
      osc.start(t);
      osc.stop(t + h.d + 0.1);
    });
  }

  function playShimmer() {
    ensureAudio();
    if (!audioCtx || !masterGain) return;
    const now = audioCtx.currentTime;
    [1568, 2093, 3136].forEach((f, i) => {
      const osc = audioCtx!.createOscillator();
      osc.type = "sine";
      osc.frequency.value = f;
      const g = audioCtx!.createGain();
      const t = now + i * 0.04;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.05, t + 0.03);
      g.gain.exponentialRampToValueAtTime(0.0005, t + 0.9);
      osc.connect(g).connect(masterGain!);
      osc.start(t);
      osc.stop(t + 1.0);
    });
  }

  function playThump() {
    ensureAudio();
    if (!audioCtx || !masterGain) return;
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    osc.type = "sine";
    osc.frequency.setValueAtTime(90, now);
    osc.frequency.exponentialRampToValueAtTime(30, now + 1.2);
    const g = audioCtx.createGain();
    g.gain.setValueAtTime(0, now);
    g.gain.linearRampToValueAtTime(0.55, now + 0.04);
    g.gain.exponentialRampToValueAtTime(0.0005, now + 1.4);
    osc.connect(g).connect(masterGain);
    osc.start(now);
    osc.stop(now + 1.5);
  }

  function playKime() {
    ensureAudio();
    if (!audioCtx || !masterGain) return;
    const now = audioCtx.currentTime;
    {
      const osc = audioCtx.createOscillator();
      osc.type = "sine";
      osc.frequency.setValueAtTime(44, now);
      osc.frequency.linearRampToValueAtTime(74, now + 1.6);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.001, now);
      g.gain.linearRampToValueAtTime(0.45, now + 1.4);
      g.gain.linearRampToValueAtTime(0.55, now + 1.9);
      g.gain.exponentialRampToValueAtTime(0.001, now + 3.0);
      osc.connect(g).connect(masterGain);
      osc.start(now);
      osc.stop(now + 3.1);
    }
    const bellStart = now + 1.2;
    [
      { f: 1318.5, g: 0.3, d: 3.6 },
      { f: 1760, g: 0.22, d: 3.0 },
      { f: 2637, g: 0.16, d: 2.4 },
      { f: 3520, g: 0.1, d: 2.0 },
      { f: 5274, g: 0.06, d: 1.4 },
    ].forEach((h, i) => {
      const osc = audioCtx!.createOscillator();
      osc.type = "sine";
      osc.frequency.value = h.f;
      const g = audioCtx!.createGain();
      const t = bellStart + i * 0.025;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(h.g * 0.3, t + 0.18);
      g.gain.linearRampToValueAtTime(h.g * 0.4, t + 0.6);
      g.gain.exponentialRampToValueAtTime(0.0005, t + h.d);
      osc.connect(g).connect(masterGain!);
      osc.start(t);
      osc.stop(t + h.d + 0.1);
    });
  }

  function startAmbient() {
    if (ambientStarted) return;
    ensureAudio();
    if (!audioCtx || !masterGain) return;
    ambientStarted = true;
    const make = (freq: number) => {
      const o = audioCtx!.createOscillator();
      o.type = "sine";
      o.frequency.value = freq;
      return o;
    };
    const osc1 = make(98);
    const osc2 = make(99.5);
    const osc3 = make(294);
    const filter = audioCtx.createBiquadFilter();
    filter.type = "lowpass";
    filter.frequency.value = 520;
    filter.Q.value = 1.1;
    const g = audioCtx.createGain();
    g.gain.value = 0.07;
    const lfo = audioCtx.createOscillator();
    lfo.frequency.value = 0.06;
    const lfoG = audioCtx.createGain();
    lfoG.gain.value = 0.035;
    lfo.connect(lfoG);
    lfoG.connect(g.gain);
    osc1.connect(filter);
    osc2.connect(filter);
    osc3.connect(filter);
    filter.connect(g).connect(masterGain);
    osc1.start();
    osc2.start();
    osc3.start();
    lfo.start();
  }

  function setMuted(m: boolean) {
    muted = m;
    if (masterGain && audioCtx) {
      const now = audioCtx.currentTime;
      masterGain.gain.cancelScheduledValues(now);
      masterGain.gain.linearRampToValueAtTime(m ? 0 : 0.55, now + 0.6);
    }
    localStorage.setItem("luxel-muted", m ? "1" : "0");
    const btn = document.getElementById("mute");
    if (btn) btn.textContent = m ? "♪ MUTE" : "♪ ON";
  }

  const muteBtn = document.getElementById("mute")!;
  muteBtn.addEventListener("click", () => {
    const next = !muted;
    setMuted(next);
    if (!next) {
      ensureAudio();
      startAmbient();
    }
  });
  muteBtn.textContent = muted ? "♪ MUTE" : "♪ ON";

  // medallion hover shimmer (debounced)
  let lastShimmer = 0;
  medallion.addEventListener("mouseenter", () => {
    if (muted) return;
    const now = Date.now();
    if (now - lastShimmer < 400) return;
    lastShimmer = now;
    playShimmer();
  });

  // ─── parallax + cursor halo ───────────────────────────
  let targetX = 0, targetY = 0, curX = 0, curY = 0;
  let haloX = 0, haloY = 0, haloTX = 0, haloTY = 0;

  window.addEventListener("mousemove", (e) => {
    targetX = (e.clientX / window.innerWidth - 0.5) * 2;
    targetY = (e.clientY / window.innerHeight - 0.5) * 2;
    haloTX = e.clientX;
    haloTY = e.clientY;
    cursorHalo.classList.add("visible");
    const r = medallion.getBoundingClientRect();
    const mcx = r.left + r.width / 2;
    const mcy = r.top + r.height / 2;
    cursorHalo.classList.toggle("is-near", Math.hypot(e.clientX - mcx, e.clientY - mcy) < 200);
  });
  window.addEventListener("mouseleave", () => cursorHalo.classList.remove("visible"));

  function tick() {
    curX += (targetX - curX) * 0.06;
    curY += (targetY - curY) * 0.06;
    haloX += (haloTX - haloX) * 0.18;
    haloY += (haloTY - haloY) * 0.18;
    worldStar.style.transform = `translate(${-curX * 16}px, ${-curY * 12}px)`;
    starfield.style.transform = `translate(${curX * 8}px, ${curY * 6}px)`;
    cursorHalo.style.transform = `translate(${haloX}px, ${haloY}px) translate(-50%, -50%)`;
    requestAnimationFrame(tick);
  }
  if (!prefersReducedMotion) requestAnimationFrame(tick);

  // ─── moon phase ───────────────────────────────────────
  const PHASE_NAMES = [
    "New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous",
    "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent",
  ];
  function moonPhase(date: Date): number {
    const synodic = 29.53058867;
    const ref = Date.UTC(2000, 0, 6, 18, 14) / 86400000;
    const now = date.getTime() / 86400000;
    return (((now - ref) % synodic) + synodic) % synodic / synodic;
  }
  function renderMoon() {
    const p = moonPhase(new Date());
    const idx = Math.round(p * 8) % 8;
    const phaseEl = document.getElementById("moonPhase");
    if (phaseEl) phaseEl.textContent = PHASE_NAMES[idx];
    const shadow = document.getElementById("moonShadow");
    if (!shadow) return;
    const illum = 1 - Math.abs(0.5 - p) * 2;
    const waxing = p < 0.5;
    const off = (1 - illum) * 26;
    shadow.style.transform = `translateX(${waxing ? off : -off}px)`;
    shadow.style.opacity = (1 - illum * 0.92).toFixed(2);
  }
  renderMoon();
  setInterval(renderMoon, 60 * 60 * 1000);

  // ─── wire interactions ────────────────────────────────
  medallion.addEventListener("click", enter);
  medallion.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      enter();
    }
  });
  document.getElementById("skip")!.addEventListener("click", (e) => {
    e.preventDefault();
    // 「skip the light」も演出に入るが、即 OAuth へ寄せたい場合は
    // submitAuth() を直接呼んでもよい。ここでは演出と統一する。
    enter();
  });
</script>
