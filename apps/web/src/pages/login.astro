---
/**
 * ログイン画面 (D 案ハイブリッド)
 *
 * - Three.js 路線は廃止 (prototypes/HANDOFF.md §1)
 * - 純 HTML / CSS / SVG の Stage.astro を 1 枚マウント
 * - 認証は Auth.js の Discord プロバイダに POST (CSRF token 必須)
 */
import Stage from "../components/login/Stage.astro";
import "../styles/global.css";

if (Astro.locals.session) {
  return Astro.redirect("/");
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>参拝 — 幽世</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&family=Shippori+Mincho+B1:wght@400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style is:global>
      html, body { overflow: hidden; }
    </style>
  </head>
  <body>
    <Stage />

    <!-- Stage.astro の submitAuth() がこの form を submit する -->
    <form
      id="auth-form"
      action="/api/auth/signin/discord"
      method="POST"
      style="display:none"
      aria-hidden="true"
    >
      <input type="hidden" name="csrfToken" id="csrf-token" value="" />
    </form>

    <script>
      // CSRF token を取得して hidden input に流し込む。
      // 取得失敗時は Stage の submitAuth() フォーム送信が CSRF エラーになるが、
      // その場合ユーザが再読み込みで救えるので致命ではない。
      (async () => {
        try {
          const res = await fetch("/api/auth/csrf");
          const data = (await res.json()) as { csrfToken?: string };
          const tokenInput = document.getElementById(
            "csrf-token",
          ) as HTMLInputElement | null;
          if (tokenInput && data.csrfToken) {
            tokenInput.value = data.csrfToken;
          }
        } catch (e) {
          console.error("Failed to fetch CSRF token:", e);
        }
      })();
    </script>
  </body>
</html>
