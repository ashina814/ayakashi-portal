---
/**
 * ログイン画面
 *
 * M1a: Discord OAuth でのログイン機能を提供する。
 * M4a: Three.js で月・霧・鳥居の3Dシーンを背景に。シェーダー・パーティクル・音は
 *      M4b〜M4d で後続。御札ボタンと CSRF フローはそのまま。
 */

// 認証済みならハブへリダイレクト
if (Astro.locals.session) {
  return Astro.redirect("/");
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>参拝 — 妖ポータル</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
      }

      body {
        min-height: 100dvh;
        background: #0a0509;
        color: #c8b880;
        font-family: "Yuji Syuku", serif;
        overflow: hidden;
        position: relative;
      }

      /* Three.js シーンを格納する全画面コンテナ */
      .scene-root {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }
      .scene-root canvas {
        display: block;
        width: 100%;
        height: 100%;
      }

      /* prefers-reduced-motion 時のフォールバック背景（scene は init されない） */
      @media (prefers-reduced-motion: reduce) {
        .scene-root {
          background:
            radial-gradient(
              ellipse at 35% 25%,
              rgba(245, 231, 196, 0.06) 0%,
              transparent 50%
            ),
            radial-gradient(
              ellipse at 50% 80%,
              rgba(184, 224, 255, 0.05) 0%,
              transparent 60%
            );
        }
      }

      .login-container {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        animation: fadeIn 2s ease-out;
      }

      /* サーバー名 */
      .server-name {
        font-size: clamp(2rem, 6vw, 3.5rem);
        letter-spacing: 0.3em;
        text-shadow:
          0 0 20px rgba(245, 231, 196, 0.35),
          0 0 40px rgba(245, 231, 196, 0.15);
        margin-top: 2rem;
      }

      /* 御札ボタン */
      .ofuda-button {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 10rem;
        background: linear-gradient(
          180deg,
          #f5f0e1 0%,
          #e8e0c8 50%,
          #d4c8a0 100%
        );
        border: 2px solid #c8b880;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow:
          0 4px 20px rgba(0, 0, 0, 0.5),
          0 0 15px rgba(200, 184, 128, 0.18);
        animation: sway 4s ease-in-out infinite;
      }

      .ofuda-button:hover {
        box-shadow:
          0 4px 20px rgba(0, 0, 0, 0.6),
          0 0 30px rgba(184, 224, 255, 0.3),
          0 0 60px rgba(184, 224, 255, 0.12);
        transform: scale(1.05);
        animation-play-state: paused;
      }

      .ofuda-button:active {
        transform: scale(0.98);
      }

      .ofuda-text {
        writing-mode: vertical-rl;
        font-family: "Yuji Syuku", serif;
        font-size: 1.4rem;
        color: #2a1a0a;
        letter-spacing: 0.4em;
        user-select: none;
      }

      @keyframes sway {
        0%, 100% { transform: rotate(-0.5deg); }
        50% { transform: rotate(0.5deg); }
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (prefers-reduced-motion: reduce) {
        .ofuda-button { animation: none; }
        .login-container { animation: none; }
      }

      @media (max-width: 480px) {
        .ofuda-button { width: 3.5rem; height: 8rem; }
        .ofuda-text { font-size: 1.2rem; }
      }
    </style>
  </head>
  <body>
    <div id="scene-root" class="scene-root" aria-hidden="true"></div>

    <main class="login-container">
      <h1 class="server-name">妖ポータル</h1>
      <form action="/api/auth/signin/discord" method="POST">
        <input type="hidden" name="csrfToken" id="csrf-token" value="" />
        <button
          type="submit"
          id="login-button"
          class="ofuda-button"
          title="Discord でログイン"
        >
          <span class="ofuda-text">参拝</span>
        </button>
      </form>
    </main>

    <script>
      // CSRF setup (既存)
      async function setupCsrf() {
        try {
          const res = await fetch("/api/auth/csrf");
          const data = await res.json();
          const tokenInput = document.getElementById("csrf-token") as HTMLInputElement | null;
          if (tokenInput && data.csrfToken) {
            tokenInput.value = data.csrfToken;
          }
        } catch (e) {
          console.error("Failed to fetch CSRF token:", e);
        }
      }
      setupCsrf();
    </script>

    <script>
      // Three.js scene mount。prefers-reduced-motion の人には初期化しない
      // （CSS グラデのフォールバックが代わりに表示される）。
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const sceneRoot = document.getElementById("scene-root");
      if (sceneRoot && !reducedMotion) {
        import("../lib/scene/torii-scene").then(({ initToriiScene }) => {
          initToriiScene(sceneRoot);
        });
      }
    </script>
  </body>
</html>
