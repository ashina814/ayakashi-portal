---
/**
 * /wiki/new — 新しい wiki ページを作る
 *
 * メタ情報（slug, title, parent）はフォーム、本文は Tiptap エディタ。
 * クライアントスクリプトで2つをまとめて POST /api/wiki/new に送る。
 * ツールバー・ヘルプは WikiEditor.astro と共通の設定（editor-toolbar.ts）。
 */

import AppShell from "../../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../lib/auth/helpers";
import {
  getWikiTree,
  hasWikiEditorPermission,
  type WikiTreeNode,
} from "../../lib/repos/wiki";
import { getMemberRoleAliases } from "../../lib/repos/membership";
import { isAdmin } from "../../lib/auth/permissions";
import {
  TOOLBAR_GROUPS,
  SHORTCUT_HINTS,
} from "../../lib/wiki/editor-toolbar";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];

if (!hasWikiEditorPermission(aliases)) {
  return Astro.rewrite("/403");
}

const tree = await getWikiTree(db, aliases);
const userIsAdmin = isAdmin(aliases);

function flatten(nodes: WikiTreeNode[], depth = 0): { slug: string; label: string }[] {
  return nodes.flatMap((n) => [
    { slug: n.slug, label: `${"　".repeat(depth)}${n.title}` },
    ...flatten(n.children, depth + 1),
  ]);
}
const parentOptions = flatten(tree);

const presetParent = Astro.url.searchParams.get("parent") ?? "";
---

<AppShell
  title="新しい巻物 — 巻物の蔵"
  active="wiki"
  wikiTree={tree}
  isAdmin={userIsAdmin}
>
  <nav class="crumbs" aria-label="パンくず">
    <a href="/wiki">巻物の蔵</a>
    <span class="sep">›</span>
    <span class="current">新規作成</span>
  </nav>

  <header class="page-header">
    <h1>新しい巻物を編む</h1>
  </header>

  <form class="meta-form" id="meta-form">
    <label class="field">
      <span class="label">slug</span>
      <input
        type="text"
        name="slug"
        required
        pattern="[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?"
        placeholder="hello-world"
      />
      <span class="hint">英小文字・数字・ハイフン（1〜64文字）。URL の一部になる。</span>
    </label>
    <label class="field">
      <span class="label">タイトル</span>
      <input type="text" name="title" required maxlength="200" />
    </label>
    <label class="field">
      <span class="label">親ページ（任意）</span>
      <select name="parentSlug">
        <option value="">— ルート —</option>
        {parentOptions.map((opt) => (
          <option value={opt.slug} selected={opt.slug === presetParent}>{opt.label}</option>
        ))}
      </select>
    </label>
  </form>

  <div class="we-root" data-api="/api/wiki/new">
    <div class="we-toolbar" role="toolbar" aria-label="編集ツール">
      {TOOLBAR_GROUPS.map((group) => (
        <div class="we-group" aria-label={group.name}>
          {group.items.map((item) => (
            <button
              type="button"
              class="we-btn"
              title={item.title}
              data-cmd={item.cmd}
              data-insert={item.insert}
            >
              {item.label}
            </button>
          ))}
        </div>
      ))}
      <div class="we-spacer"></div>
      <span class="we-status" data-status>未保存</span>
      <button type="button" class="we-btn we-btn-help" data-help-open>？ヘルプ</button>
      <button type="button" class="we-btn we-btn-primary" data-action="save">作成して開く</button>
    </div>
    <div class="we-area" data-editor></div>

    <dialog class="we-help" data-help-dialog aria-labelledby="we-help-title-new">
      <header class="we-help-head">
        <h2 id="we-help-title-new">編集ツールの使い方</h2>
        <button type="button" class="we-btn we-btn-ghost" data-help-close>閉じる</button>
      </header>

      <section class="we-help-section">
        <h3>道具一覧</h3>
        <p class="we-help-lede">
          ツールバーの各ボタンを押すと、現在のカーソル位置に対して動作します。
          範囲選択してから装飾系を押すと、その範囲だけが対象になります。
        </p>
        <table class="we-help-table">
          <tbody>
            {TOOLBAR_GROUPS.flatMap((g) =>
              g.items.map((it) => (
                <tr>
                  <th>{it.label}</th>
                  <td>{it.title}</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
      </section>

      <section class="we-help-section">
        <h3>キーボードショートカット</h3>
        <table class="we-help-table">
          <tbody>
            {SHORTCUT_HINTS.map((s) => (
              <tr>
                <th class="we-help-kbd">{s.keys}</th>
                <td>{s.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="we-help-section">
        <h3>もっと知りたい</h3>
        <p>
          <a href="/wiki/guide" target="_blank" rel="noopener">
            ▸ 編集ガイド（実例付き）を別タブで開く
          </a>
        </p>
      </section>
    </dialog>
  </div>
</AppShell>

<script>
  import { Editor } from "@tiptap/core";
  import StarterKit from "@tiptap/starter-kit";
  import Link from "@tiptap/extension-link";
  import { Callout, Toggle, StatusChip } from "../../lib/wiki/editor";
  import { bindToolbar, bindHelpDialog } from "../../lib/wiki/editor-bind";

  const root = document.querySelector<HTMLElement>(".we-root")!;
  const form = document.querySelector<HTMLFormElement>("#meta-form")!;
  const target = root.querySelector<HTMLElement>("[data-editor]")!;
  const statusEl = root.querySelector<HTMLElement>("[data-status]")!;

  const editor = new Editor({
    element: target,
    extensions: [
      StarterKit.configure({ heading: { levels: [2, 3, 4] } }),
      Link.configure({ openOnClick: false, autolink: true }),
      Callout,
      Toggle,
      StatusChip,
    ],
    content: { type: "doc", content: [{ type: "paragraph" }] },
  });

  bindToolbar(root, editor);
  bindHelpDialog(root);

  const saveBtn = root.querySelector<HTMLButtonElement>("[data-action=save]")!;
  saveBtn.addEventListener("click", async () => {
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const slug = String(fd.get("slug") ?? "").trim();
    const title = String(fd.get("title") ?? "").trim();
    const parentSlug = (fd.get("parentSlug") as string) || null;

    saveBtn.disabled = true;
    statusEl.textContent = "作成中…";
    try {
      const content = JSON.stringify(editor.getJSON());
      const res = await fetch("/api/wiki/new", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, title, parentSlug, content }),
      });
      if (res.status === 409) {
        statusEl.textContent = "slug が既に使われています";
        return;
      }
      if (!res.ok) {
        statusEl.textContent = `失敗: ${res.status} ${await res.text()}`;
        return;
      }
      const data = await res.json();
      window.location.assign(`/wiki/${data.slug}`);
    } finally {
      saveBtn.disabled = false;
    }
  });
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .crumbs a { color: var(--text-secondary); }
  .crumbs .sep { color: var(--text-muted); opacity: 0.6; }
  .crumbs .current { color: var(--text-primary); }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: 0.1em;
  }

  .meta-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background: rgba(184, 149, 64, 0.03);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field .label {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .field input,
  .field select {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.5rem 0.7rem;
  }
  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--color-gold-500);
  }
  .field .hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* ── 以下、WikiEditor.astro と同じ class 群を再宣言（scoped 分離のため） ── */
  .we-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .we-toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background: var(--bg-surface);
  }
  .we-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    padding-right: 0.5rem;
    border-right: 1px solid rgba(184, 149, 64, 0.15);
  }
  .we-group:last-of-type { border-right: none; }
  .we-spacer { flex: 1; }
  .we-btn {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0.3rem 0.65rem;
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .we-btn:hover {
    background: rgba(184, 149, 64, 0.08);
    color: var(--color-gold-100);
  }
  .we-btn-help {
    border: 1px solid rgba(184, 149, 64, 0.3);
    color: var(--color-gold-300);
  }
  .we-btn-help:hover { border-color: var(--color-gold-500); }
  .we-btn-ghost { color: var(--text-secondary); }
  .we-btn-primary {
    background: var(--color-gold-700);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
    padding: 0.4rem 1.1rem;
    font-size: 0.88rem;
  }
  .we-btn-primary:hover {
    background: var(--color-gold-500);
    color: var(--color-ink-950);
  }
  .we-status {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .we-area {
    border: 1px solid var(--border-base);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    min-height: 24rem;
    background: rgba(10, 5, 9, 0.3);
  }
  .we-area :global(.ProseMirror) { outline: none; min-height: 22rem; }

  .we-help {
    width: min(640px, 92vw);
    max-height: 86dvh;
    border: 1px solid var(--border-base);
    border-radius: 12px;
    background: var(--bg-surface);
    color: var(--text-primary);
    padding: 0;
  }
  .we-help::backdrop {
    background: rgba(10, 5, 9, 0.7);
    backdrop-filter: blur(4px);
  }
  .we-help-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-base);
    position: sticky;
    top: 0;
    background: var(--bg-surface);
  }
  .we-help-head h2 {
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .we-help-section {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.1);
  }
  .we-help-section:last-of-type { border-bottom: none; }
  .we-help-section h3 {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--color-gold-300);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .we-help-lede {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 0.85rem;
    line-height: 1.7;
  }
  .we-help-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .we-help-table th,
  .we-help-table td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.08);
    vertical-align: top;
  }
  .we-help-table th {
    color: var(--color-gold-100);
    font-weight: 500;
    white-space: nowrap;
    width: 12rem;
  }
  .we-help-table td {
    color: var(--text-secondary);
  }
  .we-help-kbd {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
  }
</style>
