---
/**
 * /wiki/[slug] — ページ詳細
 *
 * 本文は Tiptap JSON をサーバーサイドで HTML にレンダリングして表示。
 * H2/H3 から自動生成された TOC を右サイドに sticky 表示する。
 * H2 は CSS counter で「01」「02」と自動採番。
 * callout / toggle / status-chip のカスタムノードもレンダラ側で対応済み。
 */

import AppShell from "../../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../lib/auth/helpers";
import {
  getPageBySlug,
  getWikiTree,
  hasWikiEditorPermission,
} from "../../lib/repos/wiki";
import { getMemberRoleAliases } from "../../lib/repos/membership";
import { isAdmin } from "../../lib/auth/permissions";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/wiki");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const [page, tree] = await Promise.all([
  getPageBySlug(db, slug, aliases),
  getWikiTree(db, aliases),
]);

const canEdit = hasWikiEditorPermission(aliases);
const userIsAdmin = isAdmin(aliases);

if (!page) {
  return Astro.rewrite("/404");
}

const fmtDate = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<AppShell
  title={`${page.title} — 巻物の蔵`}
  active="wiki"
  wikiTree={tree}
  activeWikiSlug={page.slug}
  isAdmin={userIsAdmin}
>
  <nav class="crumbs" aria-label="パンくず">
    <a href="/wiki">巻物の蔵</a>
    {page.breadcrumbs.slice(0, -1).map((c) => (
      <>
        <span class="sep">›</span>
        <a href={`/wiki/${c.slug}`}>{c.title}</a>
      </>
    ))}
    <span class="sep">›</span>
    <span class="current">{page.title}</span>
  </nav>

  <header class="page-header">
    <div class="header-row">
      <h1>{page.title}</h1>
      {canEdit && (
        <div class="header-actions">
          <a class="edit-btn" href={`/wiki/${page.slug}/edit`}>編む</a>
          <button
            type="button"
            class="delete-btn"
            data-delete-slug={page.slug}
            data-delete-title={page.title}
          >破棄</button>
        </div>
      )}
    </div>
    <span class="meta">
      最終更新: {fmtDate.format(page.revisionCreatedAt ?? page.updatedAt)}
    </span>
  </header>

  <div class="layout">
    {page.contentHtml.length > 0 ? (
      <article class="prose" set:html={page.contentHtml} />
    ) : (
      <article class="empty">（まだ本文が書かれていない）</article>
    )}

    {page.toc.length > 0 && (
      <aside class="toc" aria-label="目次">
        <div class="toc-label">目次</div>
        <ol class="toc-list">
          {page.toc.map((t) => (
            <li class:list={["toc-item", `toc-l${t.level}`]}>
              <a href={`#${t.id}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</AppShell>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".delete-btn[data-delete-slug]");
  btn?.addEventListener("click", async () => {
    const slug = btn.dataset.deleteSlug!;
    const title = btn.dataset.deleteTitle ?? slug;
    const ok = window.confirm(
      `「${title}」を破棄します。\n\nこの巻物に紐づく全ての履歴も同時に消えます。\n本当に破棄しますか？`,
    );
    if (!ok) return;
    btn.disabled = true;
    const res = await fetch(`/api/wiki/${encodeURIComponent(slug)}`, {
      method: "DELETE",
    });
    if (res.ok) {
      window.location.assign("/wiki");
    } else {
      btn.disabled = false;
      window.alert(`破棄に失敗しました: ${res.status} ${await res.text()}`);
    }
  });
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .crumbs a { color: var(--text-secondary); }
  .crumbs a:hover { color: var(--color-gold-300); }
  .crumbs .sep { color: var(--text-muted); opacity: 0.6; }
  .crumbs .current { color: var(--text-primary); }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.15);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  h1 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    letter-spacing: 0.12em;
  }
  .header-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .edit-btn,
  .delete-btn {
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .edit-btn {
    border: 1px solid var(--color-gold-700);
    color: var(--color-gold-300);
    background: transparent;
  }
  .edit-btn:hover {
    background: rgba(184, 149, 64, 0.1);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
  }
  .delete-btn {
    border: 1px solid var(--color-crimson-700);
    color: var(--color-crimson-300);
    background: transparent;
  }
  .delete-btn:hover {
    background: rgba(193, 40, 58, 0.1);
    color: var(--color-crimson-300);
    border-color: var(--color-crimson-500);
  }
  .meta {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .toc { order: -1; }
  }

  /* ── TOC ─────────────────────────── */
  .toc {
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    padding: 1rem 1.25rem;
    border-left: 1px solid var(--border-base);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  @media (max-width: 960px) {
    .toc {
      position: static;
      max-height: none;
      border-left: none;
      border: 1px solid var(--border-base);
      border-radius: 8px;
      background: rgba(184, 149, 64, 0.03);
    }
  }

  .toc-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-item a {
    display: block;
    padding: 0.2rem 0;
    color: var(--text-secondary);
    border: none;
  }
  .toc-item a:hover { color: var(--color-gold-100); }
  .toc-l3 a { padding-left: 0.9rem; font-size: 0.82rem; }

  .empty {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* ── 本文 prose ─────────────────────── */
  .prose {
    line-height: 1.9;
    font-size: 0.98rem;
    color: var(--text-primary);
    counter-reset: section;
  }

  .prose :global(h2) {
    font-size: 1.45rem;
    letter-spacing: 0.08em;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.2);
    position: relative;
  }
  .prose :global(h2::before) {
    counter-increment: section;
    content: counter(section, decimal-leading-zero);
    display: block;
    color: var(--color-gold-500);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    margin-bottom: 0.25rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-gold-300);
  }

  .prose :global(h4) {
    font-size: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
  }

  .prose :global(.heading-anchor) {
    color: var(--color-gold-700);
    opacity: 0;
    margin-left: 0.5rem;
    font-weight: normal;
    border: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(h4:hover .heading-anchor) {
    opacity: 1;
  }
  .prose :global(.heading-anchor:hover) { color: var(--color-gold-300); }

  .prose :global(p) { margin-block: 0.85rem; }
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0.85rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) { margin-block: 0.2rem; }
  .prose :global(li::marker) { color: var(--color-gold-500); }

  .prose :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--color-gold-700);
    background: rgba(184, 149, 64, 0.04);
    color: var(--text-secondary);
    font-style: italic;
  }

  .prose :global(code) {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.88em;
    color: var(--color-mist-100);
  }
  .prose :global(pre) {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .prose :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(184, 149, 64, 0.18);
    margin: 2.5rem 0;
  }

  .prose :global(strong) { color: var(--color-gold-100); font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(s) { color: var(--text-muted); }
  .prose :global(u) { text-decoration-color: var(--color-gold-500); }

  .prose :global(a) {
    color: var(--color-gold-300);
    border-bottom: 1px solid rgba(224, 198, 132, 0.4);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .prose :global(a:hover) {
    color: var(--color-gold-100);
    border-bottom-color: var(--color-gold-100);
  }

  /* ── カスタムノード: callout ─────────────────── */
  .prose :global(.cl) {
    margin: 1.25rem 0;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
    border-left: 3px solid var(--cl-accent);
    background: var(--cl-bg);
    color: var(--text-primary);
  }
  .prose :global(.cl > .cl-title) {
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--cl-accent);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
  }
  .prose :global(.cl > .cl-body > *:first-child) { margin-top: 0; }
  .prose :global(.cl > .cl-body > *:last-child) { margin-bottom: 0; }

  .prose :global(.cl-note) {
    --cl-accent: var(--color-mist-300);
    --cl-bg: rgba(184, 202, 216, 0.05);
  }
  .prose :global(.cl-info) {
    --cl-accent: var(--color-mist-glow);
    --cl-bg: rgba(184, 224, 255, 0.06);
  }
  .prose :global(.cl-warning) {
    --cl-accent: var(--color-gold-500);
    --cl-bg: rgba(184, 149, 64, 0.07);
  }
  .prose :global(.cl-danger) {
    --cl-accent: var(--color-crimson-500);
    --cl-bg: rgba(193, 40, 58, 0.08);
  }
  .prose :global(.cl-success) {
    --cl-accent: var(--color-moss-500);
    --cl-bg: rgba(107, 138, 78, 0.08);
  }

  /* ── カスタムノード: toggle (details/summary) ── */
  .prose :global(.tg) {
    margin: 1.25rem 0;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background: rgba(10, 5, 9, 0.3);
  }
  .prose :global(.tg > summary) {
    list-style: none;
    cursor: pointer;
    padding: 0.7rem 1.1rem;
    font-size: 0.95rem;
    color: var(--color-gold-300);
    user-select: none;
    position: relative;
    padding-left: 2.2rem;
  }
  .prose :global(.tg > summary::-webkit-details-marker) { display: none; }
  .prose :global(.tg > summary::before) {
    content: "▶";
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%) rotate(0deg);
    font-size: 0.7rem;
    color: var(--color-gold-500);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .prose :global(.tg[open] > summary::before) {
    transform: translateY(-50%) rotate(90deg);
  }
  .prose :global(.tg > .tg-body) {
    padding: 0.25rem 1.1rem 0.9rem;
  }
  .prose :global(.tg > .tg-body > *:first-child) { margin-top: 0; }
  .prose :global(.tg > .tg-body > *:last-child) { margin-bottom: 0; }

  /* ── カスタムノード: status chip ───────────── */
  .prose :global(.chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    padding: 0 0.55rem;
    height: 1.4rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0;
    border: 1px solid currentColor;
    line-height: 1;
  }
  .prose :global(.chip-ok) { color: var(--color-moss-500); }
  .prose :global(.chip-ng) { color: var(--color-crimson-300); }
  .prose :global(.chip-warn) { color: var(--color-gold-500); }
  .prose :global(.chip-neutral) { color: var(--text-muted); }
</style>
