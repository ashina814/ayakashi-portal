---
/**
 * /wiki/[slug] — ページ詳細（WikiShell + D版 ArticleScreen 風）
 *
 * 本文は Tiptap JSON をサーバーサイドで HTML 化、右に sticky TOC。
 * H2 は CSS counter で自動採番、TweaksPanel の data-numbering で表記を切替。
 * 編集権限ありなら「編む」「破棄」アクションが TopBar 右に並ぶ。
 */

import WikiShell from "../../layouts/WikiShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../lib/auth/helpers";
import {
  getPageBySlug,
  hasWikiEditorPermission,
} from "../../lib/repos/wiki";
import { getMemberRoleAliases } from "../../lib/repos/membership";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/wiki");

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const page = await getPageBySlug(db, slug, aliases);

if (!page) {
  return Astro.rewrite("/404");
}

const canEdit = hasWikiEditorPermission(aliases);

const fmtDate = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const breadcrumbs = [
  { title: "巻物の蔵", href: "/wiki" },
  ...page.breadcrumbs.slice(0, -1).map((b) => ({
    title: b.title,
    href: `/wiki/${b.slug}`,
  })),
  { title: page.title },
];
---

<WikiShell title={`${page.title} — 巻物の蔵`} breadcrumbs={breadcrumbs}>
  {canEdit && (
    <Fragment slot="actions">
      <a href={`/wiki/${page.slug}/edit`} class="act-btn act-edit">編む</a>
      <button
        type="button"
        class="act-btn act-delete"
        data-delete-slug={page.slug}
        data-delete-title={page.title}
      >破棄</button>
    </Fragment>
  )}

  <div class="article-grid">
    <article class="article-main">
      <div class="art-head">
        <h1 class="art-title">{page.title}</h1>
        <div class="art-meta">
          <span><span class="k">UPDATED</span><span class="v">{fmtDate.format(page.revisionCreatedAt ?? page.updatedAt)}</span></span>
          <span class="dot">·</span>
          <span><span class="k">SLUG</span><span class="v">{page.slug}</span></span>
        </div>
      </div>

      {page.contentHtml.length > 0 ? (
        <div class="art-body" set:html={page.contentHtml} />
      ) : (
        <div class="art-empty">（まだ本文が書かれていない）</div>
      )}

      <footer class="art-foot">
        <div class="stamps" aria-hidden="true">
          <span class="stamp">幽</span>
          <span class="stamp s2">編</span>
        </div>
        <span class="art-foot-text">奉　幽世編纂局　査読済</span>
      </footer>
    </article>

    {page.toc.length > 0 && (
      <aside class="toc-pane" aria-label="目次">
        <h4>目次</h4>
        <div class="toc-strip">
          {page.toc.map((t) => (
            <a class={`toc-entry l${t.level}`} href={`#${t.id}`} data-toc-id={t.id}>
              {t.text}
            </a>
          ))}
        </div>
        <div class="toc-progress">
          <div>READING <span data-progress-val>0</span>%</div>
          <div class="bar"><div class="fill" data-progress-bar></div></div>
        </div>
      </aside>
    )}
  </div>

  <script>
    // ─── 破棄 ───
    const btn = document.querySelector<HTMLButtonElement>(
      ".act-delete[data-delete-slug]",
    );
    btn?.addEventListener("click", async () => {
      const slug = btn.dataset.deleteSlug!;
      const title = btn.dataset.deleteTitle ?? slug;
      const ok = window.confirm(
        `「${title}」を破棄します。\n\nこの巻物に紐づく全ての履歴も同時に消えます。\n本当に破棄しますか？`,
      );
      if (!ok) return;
      btn.disabled = true;
      const res = await fetch(`/api/wiki/${encodeURIComponent(slug)}`, {
        method: "DELETE",
      });
      if (res.ok) {
        window.location.assign("/wiki");
      } else {
        btn.disabled = false;
        window.alert(`破棄に失敗しました: ${res.status} ${await res.text()}`);
      }
    });

    // ─── scroll-spy + 進捗 ───
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>(".toc-entry"),
    );
    const targets = entries
      .map((e) => {
        const id = e.dataset.tocId;
        return id ? { entry: e, el: document.getElementById(id) } : null;
      })
      .filter((x): x is { entry: HTMLElement; el: HTMLElement } => !!x?.el);

    const bar = document.querySelector<HTMLElement>("[data-progress-bar]");
    const val = document.querySelector<HTMLElement>("[data-progress-val]");

    function update() {
      const scrollY = window.scrollY;
      const trigger = scrollY + window.innerHeight * 0.3;
      let activeId: string | null = null;
      for (const { el } of targets) {
        if (el.offsetTop <= trigger) activeId = el.id;
      }
      for (const { entry } of targets) {
        entry.classList.toggle("active", entry.dataset.tocId === activeId);
      }
      const max =
        document.documentElement.scrollHeight - window.innerHeight;
      const pct =
        max > 0 ? Math.min(100, Math.round((scrollY / max) * 100)) : 0;
      if (bar) bar.style.width = `${pct}%`;
      if (val) val.textContent = String(pct);
    }

    if (targets.length > 0) {
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }
  </script>
</WikiShell>

<style>
  .act-btn {
    padding: 6px 16px;
    background: transparent;
    border: 1px solid;
    font-family: "Shippori Mincho B1", serif;
    font-size: 12px;
    letter-spacing: 0.3em;
    padding-left: calc(16px + 0.3em);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .act-edit {
    color: var(--color-gold-300);
    border-color: var(--color-gold-700);
  }
  .act-edit:hover {
    background: rgba(184, 149, 64, 0.08);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
  }
  .act-delete {
    color: var(--color-crimson-500);
    border-color: rgba(193, 40, 58, 0.4);
  }
  .act-delete:hover {
    background: rgba(193, 40, 58, 0.08);
    color: var(--color-crimson-500);
  }
  .act-delete[disabled] { opacity: 0.5; cursor: not-allowed; }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px clamp(24px, 4vw, 56px) 80px;
  }
  @media (max-width: 900px) {
    .article-grid { grid-template-columns: 1fr; gap: 24px; }
    .toc-pane { display: none; }
  }

  .article-main { min-width: 0; }
  .art-head { margin-bottom: 40px; }
  .art-title {
    font-family: "Yuji Syuku", serif;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 0.95;
    margin: 0 0 18px;
    color: var(--color-gold-100);
    letter-spacing: 0.05em;
    text-shadow: 0 0 32px rgba(184, 224, 255, 0.18);
  }
  .art-meta {
    display: flex;
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid var(--color-ink-800);
    border-bottom: 1px solid var(--color-ink-800);
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    flex-wrap: wrap;
  }
  .art-meta .k { opacity: 0.6; }
  .art-meta .v { color: var(--text-secondary); margin-left: 4px; }
  .art-meta .dot { color: var(--color-ink-700); }

  .art-body {
    font-family: "Shippori Mincho B1", serif;
    color: var(--text-secondary);
    font-size: var(--wiki-fs, 16px);
    line-height: 2;
  }
  :global(html[data-density="tight"]) .art-body { line-height: 1.8; }
  :global(html[data-density="comfy"]) .art-body { line-height: 2.2; }

  .art-body :global(h2) {
    font-family: "Yuji Syuku", serif;
    font-size: 30px;
    color: var(--color-gold-100);
    margin: 56px 0 16px;
    position: relative;
    letter-spacing: 0.05em;
    counter-increment: art-h2;
    scroll-margin-top: 80px;
    text-shadow: 0 0 24px rgba(184, 224, 255, 0.1);
  }
  .art-body { counter-reset: art-h2; }

  :global(html[data-numbering="kanji"]) .art-body :global(h2)::before {
    content: counter(art-h2, cjk-ideographic);
    position: absolute;
    left: -52px;
    top: 4px;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: "Yuji Syuku", serif;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--color-gold-500);
    padding: 6px 4px;
    line-height: 1;
    border: 1px solid var(--color-gold-700);
  }
  :global(html[data-numbering="arabic"]) .art-body :global(h2)::before {
    content: counter(art-h2);
    position: absolute;
    left: -42px;
    top: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--color-gold-500);
  }
  .art-body :global(h2)::after {
    content: "";
    display: block;
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-gold-500) 0, transparent);
    margin-top: 10px;
  }

  .art-body :global(h3) {
    font-family: "Shippori Mincho B1", serif;
    font-weight: 700;
    font-size: 19px;
    color: var(--color-gold-300);
    margin: 28px 0 8px;
    padding-left: 14px;
    border-left: 1px solid var(--color-gold-700);
    scroll-margin-top: 80px;
  }
  .art-body :global(p) {
    margin: 0 0 14px;
    text-align: justify;
    font-feature-settings: "palt";
  }
  .art-body :global(a) {
    color: var(--color-gold-300);
    border-bottom: 1px solid rgba(184, 149, 64, 0.4);
    padding-bottom: 1px;
  }
  .art-body :global(a:hover) {
    color: var(--color-gold-100);
    border-bottom-color: var(--color-gold-300);
  }
  .art-body :global(strong) { color: var(--color-gold-100); font-weight: 700; }
  .art-body :global(em) {
    color: var(--color-crimson-300, #de7f8a);
    font-style: italic;
  }
  .art-body :global(blockquote) {
    margin: 26px 0;
    padding: 16px 28px;
    border-top: 1px solid var(--color-gold-700);
    border-bottom: 1px solid var(--color-gold-700);
    color: var(--color-gold-300);
    font-family: "Yuji Syuku", serif;
    font-size: var(--wiki-fs, 16px);
    letter-spacing: 0.08em;
    text-align: center;
    background: radial-gradient(
      ellipse 60% 100% at 50% 50%,
      rgba(184, 149, 64, 0.06),
      transparent 80%
    );
  }
  .art-body :global(ul),
  .art-body :global(ol) {
    margin: 8px 0 18px;
    padding-left: 24px;
  }
  .art-body :global(ul li::marker) {
    color: var(--color-gold-500);
    content: "・　";
  }
  .art-body :global(ol li::marker) {
    color: var(--color-gold-500);
    font-weight: 700;
  }
  .art-body :global(code) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.4rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
  }
  .art-body :global(pre) {
    background: rgba(10, 5, 9, 0.6);
    border: 1px solid var(--border-base);
    border-radius: 4px;
    padding: 14px 18px;
    overflow-x: auto;
    margin: 18px 0;
  }
  .art-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-gold-700);
    margin: 28px 0;
    opacity: 0.5;
  }

  .art-body :global(.cl) {
    margin: 24px 0;
    padding: 16px 20px;
    background: rgba(20, 9, 15, 0.55);
    border: 1px solid var(--color-mist-700);
    color: var(--text-secondary);
    font-size: calc(var(--wiki-fs, 16px) - 1px);
    line-height: 1.9;
  }
  .art-body :global(.cl-title) {
    font-family: "Yuji Syuku", serif;
    font-size: 15px;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
    color: var(--color-gold-100);
  }
  .art-body :global(.cl-info) {
    border-color: var(--color-mist-500);
    background: rgba(61, 85, 102, 0.1);
  }
  .art-body :global(.cl-warning) {
    border-color: var(--color-gold-500);
    background: rgba(184, 149, 64, 0.07);
  }
  .art-body :global(.cl-warning .cl-title) { color: var(--color-gold-300); }
  .art-body :global(.cl-danger) {
    border-color: var(--color-crimson-500);
    background: rgba(193, 40, 58, 0.07);
  }
  .art-body :global(.cl-success) {
    border-color: var(--color-moss-500);
    background: rgba(107, 138, 78, 0.07);
  }

  .art-body :global(.chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    font-family: "Yuji Syuku", serif;
    font-size: 13px;
    margin: 0 3px;
    vertical-align: -5px;
    border: 1px solid;
    background: rgba(10, 5, 9, 0.6);
  }
  .art-body :global(.chip-ok) {
    color: var(--color-moss-500);
    border-color: var(--color-moss-500);
    box-shadow: 0 0 8px rgba(107, 138, 78, 0.4);
  }
  .art-body :global(.chip-ng) {
    color: var(--color-crimson-500);
    border-color: var(--color-crimson-500);
    box-shadow: 0 0 8px rgba(193, 40, 58, 0.4);
  }
  .art-body :global(.chip-warn) {
    color: var(--color-gold-300);
    border-color: var(--color-gold-500);
    box-shadow: 0 0 8px rgba(184, 149, 64, 0.4);
  }

  .art-body :global(.heading-anchor) {
    opacity: 0;
    margin-left: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--color-gold-500);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .art-body :global(h2:hover .heading-anchor),
  .art-body :global(h3:hover .heading-anchor) { opacity: 0.6; }

  .art-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 2rem;
    border: 1px dashed var(--border-base);
    text-align: center;
  }

  /* ── 落款 ── */
  .art-foot {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--color-ink-800);
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: "Shippori Mincho B1", serif;
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.2em;
  }
  .stamps { display: flex; gap: 8px; align-items: center; }
  .stamp {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    font-family: "Yuji Syuku", serif;
    font-size: 14px;
    background: var(--color-crimson-500);
    color: var(--color-gold-100);
    opacity: 0.85;
    transform: rotate(-2deg);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
  }
  .stamp.s2 {
    background: var(--color-gold-500);
    color: var(--color-ink-900);
    transform: rotate(2deg);
  }
  .art-foot-text {
    letter-spacing: 0.3em;
  }

  .toc-pane {
    position: sticky;
    top: 80px;
    align-self: start;
    padding: 0 4px;
    font-family: "Noto Sans JP", sans-serif;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
  .toc-pane h4 {
    font-family: "Shippori Mincho B1", serif;
    font-size: 10px;
    letter-spacing: 0.5em;
    padding-left: 0.5em;
    color: var(--text-muted);
    margin: 0 0 18px;
    font-weight: 400;
  }
  .toc-strip {
    position: relative;
    padding-left: 18px;
  }
  .toc-strip::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-ink-800);
  }
  .toc-entry {
    position: relative;
    display: block;
    padding: 6px 0 6px 4px;
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.5;
    letter-spacing: 0.05em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .toc-entry::before {
    content: "";
    position: absolute;
    left: -19px;
    top: 11px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ink-900);
    border: 1px solid var(--color-ink-600);
    transition: all var(--dur-fast) var(--ease-out);
  }
  .toc-entry.l3 { padding-left: 16px; font-size: 10px; }
  .toc-entry.l3::before { width: 5px; height: 5px; left: -17px; top: 12px; }
  .toc-entry:hover { color: var(--color-gold-300); }
  .toc-entry.active { color: var(--color-gold-100); }
  .toc-entry.active::before {
    background: var(--color-gold-500);
    border-color: var(--color-gold-300);
    box-shadow: 0 0 8px rgba(184, 224, 255, 0.5);
  }
  .toc-progress {
    margin-top: 28px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
  .toc-progress .bar {
    height: 2px;
    background: var(--color-ink-800);
    margin-top: 6px;
    position: relative;
  }
  .toc-progress .fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(90deg, var(--color-gold-500), var(--color-gold-300));
    box-shadow: 0 0 6px rgba(184, 149, 64, 0.5);
    transition: width var(--dur-fast) var(--ease-out);
    width: 0;
  }
</style>
