---
/**
 * /wiki/[slug]/edit — Tiptap エディタで wiki ページを編集する
 *
 * - 未認証は /login
 * - wiki_editor alias を持たない場合は 403
 * - 楽観ロック: 開いた時点の current_revision_id をエディタに渡し、
 *   保存時に再確認する。
 */

import WikiShell from "../../../layouts/WikiShell.astro";
import WikiEditor from "../../../components/WikiEditor.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../../lib/auth/helpers";
import {
  getPageBySlug,
  getPageVisibility,
  hasWikiEditorPermission,
} from "../../../lib/repos/wiki";
import { listRoleAliases } from "../../../lib/repos/admin";
import { getMemberRoleAliases } from "../../../lib/repos/membership";
import { wikiPages } from "@ayakashi/db";
import { eq } from "drizzle-orm";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/wiki");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];

if (!hasWikiEditorPermission(aliases)) {
  return Astro.rewrite("/403");
}

const page = await getPageBySlug(db, slug, aliases);

if (!page) {
  return Astro.rewrite("/404");
}

// 楽観ロック用に現在の current_revision_id を取り直す（getPageBySlug は revisionId 自体は返さないため）
const [meta, visibility, knownAliases] = await Promise.all([
  db
    .select({ currentRevisionId: wikiPages.currentRevisionId })
    .from(wikiPages)
    .where(eq(wikiPages.id, page.id))
    .limit(1)
    .then((rows) => rows[0]),
  getPageVisibility(db, page.id),
  listRoleAliases(db),
]);

const breadcrumbs = [
  { title: "巻物の蔵", href: "/wiki" },
  ...page.breadcrumbs.slice(0, -1).map((b) => ({
    title: b.title,
    href: `/wiki/${b.slug}`,
  })),
  { title: page.title, href: `/wiki/${page.slug}` },
  { title: "編む" },
];
---

<WikiShell title={`編集: ${page.title} — 巻物の蔵`} breadcrumbs={breadcrumbs}>
  <a slot="actions" href={`/wiki/${page.slug}`} class="back-btn">戻る</a>

  <div class="edit-page">
  <header class="page-header">
    <h1>{page.title} を編む</h1>
    <span class="meta">
      slug: <code>{page.slug}</code>
    </span>
  </header>

  <WikiEditor
    initialContent={page.content}
    apiEndpoint={`/api/wiki/${page.slug}`}
    redirectOnSuccess={`/wiki/${page.slug}`}
    expectedRevisionId={meta?.currentRevisionId ?? null}
  />

  <section class="visibility-card" data-visibility-section data-slug={page.slug}>
    <header>
      <h2>閲覧制限</h2>
      <p class="lede">
        ここに役名 (alias) を1つ以上入れると、その役を持つ妖だけがこのページを見られる。
        空にすると誰でも見られる（全公開）。
      </p>
    </header>

    <div class="vis-current">
      <span class="vis-label">現在の制限:</span>
      {visibility.length === 0 ? (
        <span class="vis-public">公開（誰でも閲覧可）</span>
      ) : (
        <div class="vis-chips">
          {visibility.map((a) => (
            <code class="vis-chip">{a}</code>
          ))}
        </div>
      )}
    </div>

    <form class="vis-form" id="vis-form">
      <label class="field">
        <span class="label">許可する役名（カンマ区切りで複数指定可）</span>
        <input
          type="text"
          name="aliases"
          list="known-aliases-edit"
          value={visibility.join(", ")}
          placeholder="wiki_editor, admin"
        />
        <datalist id="known-aliases-edit">
          {knownAliases.map((a) => (
            <option value={a.alias}>{a.roleName}</option>
          ))}
        </datalist>
        <span class="hint">空欄にすると全公開に戻る</span>
      </label>
      <div class="vis-actions">
        <span class="status" data-vis-status></span>
        <button type="submit" class="ay-btn">この制限で固める</button>
      </div>
    </form>
  </section>
  </div>
</WikiShell>

<script>
  const form = document.querySelector<HTMLFormElement>("#vis-form");
  const section = document.querySelector<HTMLElement>("[data-visibility-section]");
  if (form && section) {
    const statusEl = form.querySelector<HTMLElement>("[data-vis-status]")!;
    const slug = section.dataset.slug!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const raw = String(new FormData(form).get("aliases") ?? "");
      const aliases = raw
        .split(",")
        .map((s) => s.trim())
        .filter((s) => s.length > 0);
      statusEl.textContent = "保存中…";
      const res = await fetch(
        `/api/wiki/${encodeURIComponent(slug)}/visibility`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ aliases }),
        },
      );
      if (res.ok) {
        statusEl.textContent = "保存しました";
        // 表示更新のために軽くリロード
        window.location.reload();
      } else {
        statusEl.textContent = `失敗: ${res.status} ${await res.text()}`;
      }
    });
  }
</script>

<style>
  .edit-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px clamp(20px, 4vw, 48px) 64px;
  }
  .back-btn {
    padding: 6px 16px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--color-ink-600);
    font-family: "Shippori Mincho B1", serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    padding-left: calc(16px + 0.2em);
  }
  .back-btn:hover {
    color: var(--color-gold-300);
    border-color: var(--color-gold-700);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .crumbs a { color: var(--text-secondary); }
  .crumbs a:hover { color: var(--color-gold-300); }
  .crumbs .sep { color: var(--text-muted); opacity: 0.6; }
  .crumbs .current { color: var(--text-primary); }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: 0.1em;
  }
  .meta {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .meta code {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.4rem;
    font-family: "JetBrains Mono", monospace;
    color: var(--color-mist-100);
  }

  .visibility-card {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--border-base);
    border-radius: 10px;
    background: rgba(184, 149, 64, 0.03);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .visibility-card h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-gold-300);
    margin: 0 0 0.5rem;
  }
  .visibility-card .lede {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
  }

  .vis-current {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .vis-label {
    color: var(--text-muted);
  }
  .vis-public {
    color: var(--color-moss-500);
  }
  .vis-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .vis-chip {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.45rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82em;
    color: var(--color-gold-100);
  }

  .vis-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .vis-form .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .vis-form .label {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
  .vis-form input {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.5rem 0.7rem;
  }
  .vis-form input:focus {
    outline: none;
    border-color: var(--color-gold-500);
  }
  .vis-form .hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .vis-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }
  .vis-actions .status {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
</style>
