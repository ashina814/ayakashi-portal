---
/**
 * /wiki — ページ一覧
 *
 * 公開範囲制限は M3b で適用済み（getMemberRoleAliases → listPages）。
 * 編集 UI は M3c で追加。
 */

import AppShell from "../../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../lib/auth/helpers";
import { listPages } from "../../lib/repos/wiki";
import { getMemberRoleAliases } from "../../lib/repos/membership";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const pages = await listPages(db, aliases);

const fmtDate = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<AppShell title="巻物の蔵 — 妖ポータル" active="wiki">
  <header class="header">
    <h1>巻物の蔵</h1>
    <p class="lede">妖たちが綴った記録の一覧。</p>
  </header>

  <section class="pages">
    {pages.length === 0 ? (
      <div class="empty">まだ何も記されていない</div>
    ) : (
      pages.map((p) => (
        <a class="page-link" href={`/wiki/${p.slug}`}>
          <span class="title">{p.title}</span>
          <span class="updated">{fmtDate.format(p.updatedAt)}</span>
        </a>
      ))
    )}
  </section>
</AppShell>

<style>
  .header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: 0.18em;
  }
  .lede {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .pages {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-base);
    border-radius: 10px;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .page-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 1.5rem;
    color: var(--text-primary);
    border-top: 1px solid rgba(184, 149, 64, 0.08);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .page-link:first-child { border-top: none; }
  .page-link:hover { background: rgba(184, 149, 64, 0.06); }

  .title {
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .updated {
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
