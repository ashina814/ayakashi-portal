---
/**
 * /timeline — 年表（Chronicle）
 *
 * 沿革を「ひとつの星座」として描く星図プレート。各出来事を等級つきの星で
 * プロットし時間順に星座線で結ぶ。星 ⇔ 観測記録（ログ）が双方向連動。
 * 星座線は mount 時に自走描画（client script）。
 *
 * nodes はプレースホルダー。後で DB/設定ファイルへ外出しする。
 */

import LuxelShell from "../layouts/LuxelShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../lib/auth/helpers";
import { getMemberRoleAliases } from "../lib/repos/membership";
import { isAdmin } from "../lib/auth/permissions";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);
const userId = (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const userIsAdmin = isAdmin(aliases);

interface Node {
  g: string;
  date: string;
  era: string;
  title: string;
  desc: string;
  tag: string;
  x: number;
  y: number;
  mag: number;
  now?: boolean;
}

const nodes: Node[] = [
  { g: "α", date: "2024.03", era: "黎明 · MMXXIV", title: "最初の灯がともる", desc: "創設メンバー数名で、暗がりにひとつの光を掲げた。サーバーの原型はこの夜に生まれた。", tag: "創設", x: 16, y: 33, mag: 3 },
  { g: "β", date: "2024.06", era: "黎明 · MMXXIV", title: "観測規約をさだめる", desc: "静けさを守るための約束ごとを整え、ロールの基礎を設計。場所の輪郭がはっきりしてきた。", tag: "制度", x: 33, y: 63, mag: 2 },
  { g: "γ", date: "2024.10", era: "黎明 · MMXXIV", title: "百の灯", desc: "メンバーが100名を超える。最初の大きな集いを開き、星座のように人がつながりはじめた。", tag: "節目", x: 45, y: 22, mag: 3 },
  { g: "δ", date: "2025.02", era: "拡張 · MMXXV", title: "bot『Astra』稼働", desc: "ロール付与と告知を担う観測補助botを導入。運用が一段なめらかになった。", tag: "システム", x: 62, y: 55, mag: 2 },
  { g: "ε", date: "2025.08", era: "拡張 · MMXXV", title: "アーカイブ計画始動", desc: "交わされた言葉や催しを記録に残す試みを開始。年表とWikiの構想がここから動き出す。", tag: "記録", x: 76, y: 34, mag: 2 },
  { g: "✦", date: "2026.06", era: "現在 · MMXXVI", title: "LUXEL リニューアル", desc: "ログインから本体まで、星の観測所として世界観を統一。いまこの瞬間も、歴史は紡がれ続けている。", tag: "現在", x: 88, y: 70, mag: 4, now: true },
];

const points = nodes.map((n) => `${n.x},${n.y}`).join(" ");

// 時代ごとにグルーピング（順序保持）
interface Era {
  label: string;
  items: (Node & { idx: number })[];
}
const eras: Era[] = [];
nodes.forEach((n, i) => {
  let e = eras.find((x) => x.label === n.era);
  if (!e) {
    e = { label: n.era, items: [] };
    eras.push(e);
  }
  e.items.push({ ...n, idx: i });
});
---

<LuxelShell title="LUXEL — 年表" active="timeline" isAdmin={userIsAdmin}>
  <div class="page page-in">
    <header class="phead">
      <div class="eyebrow">Chronicle</div>
      <h1 class="ptitle">年表</h1>
      <div class="psub">the LUXEL constellation</div>
      <div class="phead-rule"></div>
    </header>

    <p class="atlas-intro">
      歩んできた歴史を、ひとつの星座として描き起こしました。明るい星ほど大きな節目。
      線は時間の順に結ばれ、いちばん端の <span class="ai-nova">新星</span> は——いまも形を成し続けています。
    </p>

    <div class="atlas-plate">
      <svg class="atlas-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <g class="atlas-grid">
          {[10, 20, 30, 40, 50, 60, 70, 80, 90].map((v) => (
            <line x1={v} y1="0" x2={v} y2="100" vector-effect="non-scaling-stroke" />
          ))}
          {[20, 40, 60, 80].map((v) => (
            <line x1="0" y1={v} x2="100" y2={v} vector-effect="non-scaling-stroke" />
          ))}
        </g>
        <path class="atlas-ecliptic" d="M0,52 C 26,34 58,58 100,30" vector-effect="non-scaling-stroke" fill="none" />
        <polyline class="atlas-link" points={points} vector-effect="non-scaling-stroke" fill="none" data-link></polyline>
      </svg>

      <div class="atlas-plate-id">PLATE I · LVXEL CHRONICLE</div>
      <div class="atlas-epoch">EPOCH 2024 — 2026</div>
      <div class="atlas-compass"><span class="ac-n">N</span><span class="ac-arrow"></span></div>

      {nodes.map((n, i) => (
        <button
          class:list={["star", { now: n.now, big: n.mag >= 3, active: i === 0 }]}
          style={`left:${n.x}%;top:${n.y}%;--r:${6 + n.mag * 3.2}px`}
          data-star={i}
          aria-label={`${n.date} ${n.title}`}
        >
          <span class="s-halo" aria-hidden="true"></span>
          <span class="s-dot"></span>
          <span class="s-label">{n.g} · {n.date}</span>
        </button>
      ))}

      <div class="atlas-axis">
        <span style="left:24%">黎明</span>
        <span style="left:63%">拡張</span>
        <span style="left:88%">現在</span>
      </div>
    </div>

    <div class="atlas-log">
      <div class="al-head">観測記録 — Observation Log</div>
      {eras.map((era) => (
        <div class="al-era">
          <div class="al-era-label">{era.label}</div>
          {era.items.map((n) => (
            <div
              class:list={["log-row", { active: n.idx === 0, now: n.now }]}
              data-row={n.idx}
            >
              <div class="log-g">{n.g}</div>
              <div class="log-meta">
                <div class="log-date">{n.date}</div>
                <div class="log-mag">mag {n.mag.toFixed(1)}</div>
              </div>
              <div class="log-main">
                <div class="log-title">
                  {n.title}
                  {n.now && <span class="log-here">— いま、ここ</span>}
                </div>
                <div class="log-desc"><p>{n.desc}</p><span class="log-tag">{n.tag}</span></div>
              </div>
            </div>
          ))}
        </div>
      ))}
      <div class="al-weaving">紡がれ続けています…</div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const stars = Array.from(document.querySelectorAll("[data-star]"));
      const rows = Array.from(document.querySelectorAll("[data-row]"));
      let active = 0;
      function setActive(i) {
        if (i === active) return;
        active = i;
        stars.forEach((s) => s.classList.toggle("active", Number(s.dataset.star) === i));
        rows.forEach((r) => r.classList.toggle("active", Number(r.dataset.row) === i));
      }
      stars.forEach((s) => {
        const i = Number(s.dataset.star);
        s.addEventListener("mouseenter", () => setActive(i));
        s.addEventListener("focus", () => setActive(i));
        s.addEventListener("click", () => setActive(i));
      });
      rows.forEach((r) => {
        const i = Number(r.dataset.row);
        r.addEventListener("mouseenter", () => setActive(i));
        r.addEventListener("click", () => setActive(i));
      });

      // 星座線の自走描画
      const path = document.querySelector("[data-link]");
      if (path && path.getTotalLength) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = len;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !len) {
          path.style.strokeDashoffset = "0";
        } else {
          path.style.strokeDashoffset = len;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              path.style.transition = "stroke-dashoffset 1.9s var(--ease) 0.25s";
              path.style.strokeDashoffset = "0";
            }),
          );
          setTimeout(() => {
            path.style.strokeDashoffset = "0";
          }, 2600);
        }
      }
    })();
  </script>
</LuxelShell>
