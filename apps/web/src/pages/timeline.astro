---
/**
 * /timeline — 年表（Chronicle、縦のクロニクル）
 *
 * 沿革を「ひとすじの光」として上から下へ。時代（章）ごとにまとめ、左の発光
 * レールがスクロールに合わせて伸び、最下部の「現在＝新星」が暖色で脈動する。
 *
 * nodes はプレースホルダー。後で DB / 設定ファイルへ外出しする。
 */

import LuxelShell from "../layouts/LuxelShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../lib/auth/helpers";
import { getMemberRoleAliases } from "../lib/repos/membership";
import { isAdmin } from "../lib/auth/permissions";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);
const userId = (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const userIsAdmin = isAdmin(aliases);

interface Node {
  date: string;
  era: string;
  rom: string;
  title: string;
  desc: string;
  tag: string;
  now?: boolean;
}

const nodes: Node[] = [
  { date: "2024.03", era: "黎明", rom: "MMXXIV", title: "最初の灯がともる", desc: "創設メンバー数名で、暗がりにひとつの光を掲げた。サーバーの原型は、この夜に生まれた。", tag: "創設" },
  { date: "2024.06", era: "黎明", rom: "MMXXIV", title: "観測規約をさだめる", desc: "静けさを守るための約束ごとを整え、ロールの基礎を設計。場所の輪郭が、すこしずつ立ち上がる。", tag: "制度" },
  { date: "2024.10", era: "黎明", rom: "MMXXIV", title: "百の灯", desc: "メンバーが100名を超える。最初の大きな集いを開き、人と人が星座のようにつながりはじめた。", tag: "節目" },
  { date: "2025.02", era: "拡張", rom: "MMXXV", title: "bot『Astra』稼働", desc: "ロール付与と告知を担う観測補助botを導入。日々の運用が、ぐっとなめらかになった。", tag: "システム" },
  { date: "2025.08", era: "拡張", rom: "MMXXV", title: "アーカイブ計画始動", desc: "交わされた言葉や催しを記録に残す試みを開始。年表とWikiの構想が、ここから動き出す。", tag: "記録" },
  { date: "2026.06", era: "現在", rom: "MMXXVI", title: "LUXEL リニューアル", desc: "ログインから本体まで、ひとつの星の観測所として世界観を統一。いまこの瞬間も、歴史は紡がれ続けている。", tag: "現在", now: true },
];

const ROM = ["I", "II", "III", "IV", "V"];
interface Chapter {
  era: string;
  rom: string;
  year: string;
  items: (Node & { gi: number })[];
}
const chapters: Chapter[] = [];
nodes.forEach((n) => {
  let c = chapters.find((x) => x.era === n.era);
  if (!c) {
    c = { era: n.era, rom: n.rom, year: n.date.split(".")[0], items: [] };
    chapters.push(c);
  }
  c.items.push({ ...n, gi: 0 });
});
let k = 0;
chapters.forEach((c) => c.items.forEach((it) => (it.gi = k++)));

const skyline = [44, 72, 58, 96, 64, 120, 80, 102, 70, 132, 56, 88, 62, 110, 48, 84, 68, 118, 52, 78];
---

<LuxelShell title="LUXEL — 年表" active="timeline" isAdmin={userIsAdmin}>
  <div class="page page-in">
    <header class="phead">
      <div class="eyebrow">Chronicle</div>
      <h1 class="ptitle">年表</h1>
      <div class="psub">光の系譜</div>
      <div class="phead-rule"></div>
    </header>

    <p class="chron-intro">
      歩んできた歴史を、ひとすじの光として書き留めました。上から下へ、灯はすこしずつ強くなり——
      いちばん下の <em>新星</em> は、いまも形を成し続けています。
    </p>

    <div class="chron" data-chron>
      <div class="chron-rail" data-rail>
        <div class="chron-rail-base"></div>
        <div class="chron-rail-fill" data-fill></div>
      </div>

      {chapters.map((c, ci) => (
        <section class="chron-chapter">
          <div class="chron-ch-head" data-reveal>
            <span class="cc-year" aria-hidden="true">{c.year}</span>
            <span class="cc-marker" aria-hidden="true"></span>
            <span class="cc-rn">{ROM[ci]}</span>
            <div class="cc-name">{c.era}</div>
            <div class="cc-sub">{c.rom}</div>
          </div>
          {c.items.map((n) => (
            <article class:list={["chron-node", { now: n.now }]} data-reveal data-gi={n.gi}>
              <span class="cn-dot" aria-hidden="true" data-dot={n.gi}></span>
              <div class="cn-date">{n.date}</div>
              <h3 class="cn-title">
                {n.title}{n.now && <span class="cn-here">いま、ここ</span>}
              </h3>
              <p class="cn-desc">{n.desc}</p>
              <span class="cn-tag">{n.tag}</span>
            </article>
          ))}
        </section>
      ))}

      <div class="chron-skyline" aria-hidden="true">
        {skyline.map((hgt) => (
          <div class="chron-bldg" style={`height:${hgt}px`}>
            {hgt > 78 && <i style={`top:${Math.round(hgt * 0.3)}px;transform:translateX(-50%)`}></i>}
            {hgt > 112 && <i style={`top:${Math.round(hgt * 0.56)}px;left:68%`}></i>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("[data-chron]");
    if (root) {
      const rail = root.querySelector<HTMLElement>("[data-rail]")!;
      const fill = root.querySelector<HTMLElement>("[data-fill]")!;
      const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
      const revealables = Array.from(root.querySelectorAll<HTMLElement>("[data-reveal]"));
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const armed = !reduce;
      if (armed) root.classList.add("armed");

      let maxRevealed = -1;

      function measureFill(i: number) {
        const dot = dots[i];
        if (!dot) return;
        const railTop = rail.getBoundingClientRect().top;
        const d = dot.getBoundingClientRect();
        fill.style.height = Math.max(0, d.top + d.height / 2 - railTop) + "px";
      }

      function show(el: HTMLElement) {
        el.classList.add("is-in");
        el.style.opacity = "1";
        el.style.transform = "none";
        window.setTimeout(() => {
          if (parseFloat(getComputedStyle(el).opacity || "1") < 0.99) {
            el.style.transition = "none";
            el.style.opacity = "1";
            el.style.transform = "none";
          }
        }, 1100);
      }

      if (!armed) {
        revealables.forEach(show);
        requestAnimationFrame(() => measureFill(dots.length - 1));
      } else {
        const reveal = () => {
          const trigger = window.innerHeight * 0.9;
          revealables.forEach((el) => {
            if (el.classList.contains("is-in")) return;
            if (el.getBoundingClientRect().top < trigger) {
              show(el);
              const gi = el.dataset.gi;
              if (gi !== undefined) maxRevealed = Math.max(maxRevealed, +gi);
            }
          });
          measureFill(maxRevealed);
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            reveal();
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        reveal();
        requestAnimationFrame(reveal);
        window.setTimeout(reveal, 300);
      }
    }
  </script>
</LuxelShell>
