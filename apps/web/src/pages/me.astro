---
/**
 * /me — マイページ
 *
 * 表示: アバター, 表示名, ニックネーム, 入鯖日, ロール一覧, 自己紹介
 * 自己紹介は ?edit=1 で textarea を開いて POST /api/me/bio で更新する。
 */

import AppShell from "../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../lib/auth/helpers";
import {
  getMemberWithRoles,
  BIO_MAX_LENGTH,
} from "../lib/repos/membership";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const user = Astro.locals.session.user;
const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId = (user as { id?: string } | undefined)?.id;
const member = userId ? await getMemberWithRoles(db, userId) : null;

const joinedAtLabel = member?.joinedAt
  ? new Intl.DateTimeFormat("ja-JP", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(member.joinedAt)
  : "—";

const isEditing = Astro.url.searchParams.get("edit") === "1";
const bio = member?.bio ?? "";
---

<AppShell title="マイページ — 妖ポータル" active="me">
  <h1 class="page-title">己が記録</h1>

  <section class="card">
    <div class="profile">
      {user?.image && (
        <img
          class="avatar-lg"
          src={user.image}
          alt={user.name ?? "ユーザー"}
          width="84"
          height="84"
        />
      )}
      <div>
        <div class="name">{user?.name ?? "名無しの妖"}</div>
        {member?.nickname && (
          <div class="nick">サーバー内呼び名: {member.nickname}</div>
        )}
      </div>
    </div>

    <dl class="profile-dl">
      <dt>入鯖日</dt>
      <dd>{joinedAtLabel}</dd>

      <dt>ロール</dt>
      <dd>
        {member && member.roles.length > 0 ? (
          <div class="roles">
            {member.roles.map((r) => (
              <span
                class="role-chip"
                style={r.color ? `color: ${r.color};` : ""}
              >
                {r.name}
              </span>
            ))}
          </div>
        ) : (
          <span class="empty">（取得中、または所属ロールなし）</span>
        )}
      </dd>
    </dl>
  </section>

  <section class="card bio-section">
    <div class="bio-header">
      <span class="label">己が言の葉</span>
      {!isEditing && <a class="bio-edit" href="/me?edit=1">編集する</a>}
    </div>

    {isEditing ? (
      <form class="bio-form" method="POST" action="/api/me/bio">
        <textarea
          class="ay-textarea"
          name="bio"
          maxlength={BIO_MAX_LENGTH}
          placeholder="己を語れ"
        >{bio}</textarea>
        <div class="bio-footer">
          <span class="bio-hint">最大 {BIO_MAX_LENGTH} 文字</span>
          <div class="bio-actions">
            <a class="ay-btn ay-btn-ghost" href="/me">取り消す</a>
            <button class="ay-btn" type="submit">封ずる</button>
          </div>
        </div>
      </form>
    ) : (
      <div class="bio-text">
        {bio.length > 0 ? bio : (
          <span class="empty">（まだ何も記されていない）</span>
        )}
      </div>
    )}
  </section>
</AppShell>

<style>
  .page-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: 0.18em;
    margin-bottom: 1.5rem;
  }

  .card {
    background: var(--bg-elevated);
    border-radius: 10px;
    box-shadow: var(--elev-1);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .avatar-lg {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 2px solid rgba(184, 149, 64, 0.3);
  }

  .name {
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .nick {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .profile-dl {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.75rem 1.25rem;
    font-size: 0.95rem;
  }
  .profile-dl dt { color: var(--text-muted); }

  .roles { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .role-chip {
    padding: 0.2rem 0.7rem;
    font-size: 0.82rem;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .empty {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .bio-section { display: flex; flex-direction: column; gap: 0.75rem; }
  .bio-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .bio-header .label {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .bio-edit {
    font-size: 0.85rem;
  }

  .bio-text {
    white-space: pre-wrap;
    line-height: 1.9;
    font-size: 0.95rem;
    min-height: 1.8em;
  }

  .bio-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .bio-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
  }
  .bio-hint { color: var(--text-muted); }
  .bio-actions { display: flex; gap: 0.75rem; }
</style>
