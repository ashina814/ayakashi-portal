---
/**
 * 妖ポータル — ハブ（トップページ）
 *
 * M1a: 認証チェック + ユーザー情報表示
 * M5 で襖 UI に差し替え予定。
 */

// 未認証ならログイン画面へ
if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const user = Astro.locals.session.user;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>妖ポータル</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #0a0509;
        color: #c8b880;
        font-family: "Yuji Syuku", serif;
        gap: 2rem;
      }

      h1 {
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        letter-spacing: 0.2em;
      }

      .user-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem;
        border: 1px solid rgba(200, 184, 128, 0.2);
        border-radius: 8px;
        background: rgba(200, 184, 128, 0.03);
      }

      .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 2px solid rgba(200, 184, 128, 0.3);
      }

      .username {
        font-size: 1.2rem;
      }

      .status {
        font-size: 0.9rem;
        opacity: 0.7;
      }

      .logout-link {
        color: #c8b880;
        opacity: 0.6;
        text-decoration: none;
        font-size: 0.85rem;
        transition: opacity 0.2s;
      }

      .logout-link:hover {
        opacity: 1;
      }

      .nav-placeholder {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
        font-size: 0.9rem;
      }

      .nav-placeholder a {
        color: #c8b880;
        text-decoration: none;
        opacity: 0.85;
        border-bottom: 1px solid rgba(200, 184, 128, 0.3);
        transition: opacity 0.2s;
      }

      .nav-placeholder a:hover { opacity: 1; }

      .nav-placeholder span { opacity: 0.4; }
    </style>
  </head>
  <body>
    <h1>妖ポータル</h1>
    <div class="user-info">
      {user?.image && (
        <img
          class="avatar"
          src={user.image}
          alt={user.name ?? "ユーザー"}
          width="80"
          height="80"
        />
      )}
      <span class="username">{user?.name ?? "名無しの妖"}</span>
      <span class="status">認証済み ✓</span>
    </div>
    <div class="nav-placeholder">
      <a href="/me">マイページ</a>
      <a href="/wiki">巻物の蔵</a>
    </div>
    <a class="logout-link" href="/api/auth/signout">
      退出する
    </a>
  </body>
</html>
