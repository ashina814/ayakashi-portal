---
/**
 * 妖ポータル — ハブ（トップページ）
 *
 * 認証済みなら歓迎メッセージ、未認証は /login にリダイレクト。
 * M5 で襖 UI に差し替え予定。
 */

import AppShell from "../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../lib/auth/helpers";
import { getMemberRoleAliases } from "../lib/repos/membership";
import { isAdmin } from "../lib/auth/permissions";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const user = Astro.locals.session.user;
const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);
const userId = (user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const userIsAdmin = isAdmin(aliases);
---

<AppShell title="妖ポータル" active="home" isAdmin={userIsAdmin}>
  <section class="hero">
    <h1>ようこそ、{user?.name ?? "名無しの妖"} 殿</h1>
    <p class="lede">
      お主の記録は左の項目より辿られたし。<br />
      巻物の蔵には他の妖たちが残した知見が眠る。
    </p>

    <div class="cta-grid">
      <a class="cta-card" href="/me">
        <span class="cta-title">マイページ</span>
        <span class="cta-desc">己の役割・入鯖日・自己紹介を確かめる</span>
      </a>
      <a class="cta-card" href="/wiki">
        <span class="cta-title">巻物の蔵</span>
        <span class="cta-desc">妖たちが綴った記録を辿る</span>
      </a>
    </div>
  </section>
</AppShell>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2rem 4rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: 0.12em;
    line-height: 1.35;
  }

  .lede {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 36rem;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--bg-elevated);
    border-radius: 10px;
    box-shadow: var(--elev-1);
    color: var(--text-primary);
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }
  .cta-card:hover {
    box-shadow: var(--elev-2);
  }

  .cta-title {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
  }
  .cta-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
</style>
