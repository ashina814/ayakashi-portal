---
/**
 * /admin/aliases — role_aliases を画面から追加・削除する
 *
 * admin alias を持つユーザーのみアクセス可。
 * 既知 alias の候補（admin, wiki_editor）はサジェスト表示。
 */

import AppShell from "../../layouts/AppShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../../lib/auth/helpers";
import { getMemberRoleAliases } from "../../lib/repos/membership";
import {
  ADMIN_ALIAS,
  WIKI_EDITOR_ALIAS,
  isAdmin,
} from "../../lib/auth/permissions";
import {
  listAllRoles,
  listRoleAliases,
} from "../../lib/repos/admin";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);

const userId =
  (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];

if (!isAdmin(aliases)) {
  return Astro.rewrite("/403");
}

const [allAliases, allRoles] = await Promise.all([
  listRoleAliases(db),
  listAllRoles(db),
]);

const knownAliases = [
  { value: ADMIN_ALIAS, desc: "管理者：すべての操作を許可" },
  { value: WIKI_EDITOR_ALIAS, desc: "巻物の蔵を編集できる" },
];
---

<AppShell title="役名管理 — 妖ポータル" active="admin" isAdmin>
  <header class="page-header">
    <h1>役名管理</h1>
    <p class="lede">
      Discord のロールに、アプリ内で意味を持つ「役名」を貼り付ける場所。
      たとえば「巻物の編み手」というロールに <code>wiki_editor</code> を貼れば、
      そのロールを持つ妖が巻物を編めるようになる。
    </p>
  </header>

  <section class="card">
    <h2>役名を新しく付ける</h2>
    <form id="alias-form" class="add-form">
      <label class="field">
        <span class="label">役名 (alias)</span>
        <input
          type="text"
          name="alias"
          required
          pattern="[a-z][a-z0-9_]{1,31}"
          list="known-aliases"
          placeholder="wiki_editor"
        />
        <datalist id="known-aliases">
          {knownAliases.map((k) => (
            <option value={k.value}>{k.desc}</option>
          ))}
        </datalist>
        <span class="hint">英小文字・数字・アンダースコア（2〜32文字）</span>
      </label>
      <label class="field">
        <span class="label">対象ロール</span>
        <select name="roleId" required>
          <option value="">— 選択 —</option>
          {allRoles.map((r) => (
            <option value={r.id}>{r.name}（{r.discordRoleId}）</option>
          ))}
        </select>
        <span class="hint">Bot 未稼働時はロール名が「Unknown Role (…)」のまま</span>
      </label>
      <div class="actions">
        <span class="status" data-status></span>
        <button class="btn btn-primary" type="submit">貼り付ける</button>
      </div>
    </form>
  </section>

  <section class="card">
    <h2>現在の役名一覧（{allAliases.length} 件）</h2>
    {allAliases.length === 0 ? (
      <p class="empty">まだ何も貼られていない</p>
    ) : (
      <div class="table-scroll"><table class="alias-table">
        <thead>
          <tr>
            <th>役名 (alias)</th>
            <th>対象ロール</th>
            <th>Discord Role ID</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {allAliases.map((a) => (
            <tr>
              <td><code class="alias">{a.alias}</code></td>
              <td>{a.roleName}</td>
              <td class="mono">{a.discordRoleId}</td>
              <td class="cell-action">
                <button
                  type="button"
                  class="btn btn-danger"
                  data-delete-alias={a.id}
                  data-delete-label={`${a.alias} → ${a.roleName}`}
                >剥がす</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table></div>
    )}
  </section>
</AppShell>

<script>
  const form = document.querySelector<HTMLFormElement>("#alias-form")!;
  const statusEl = form.querySelector<HTMLElement>("[data-status]")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const alias = String(fd.get("alias") ?? "").trim();
    const roleId = String(fd.get("roleId") ?? "");
    statusEl.textContent = "追加中…";
    const res = await fetch("/api/admin/aliases", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ alias, roleId }),
    });
    if (res.status === 409) {
      statusEl.textContent = "その役名は既に使われています";
      return;
    }
    if (!res.ok) {
      statusEl.textContent = `失敗: ${res.status} ${await res.text()}`;
      return;
    }
    window.location.reload();
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-delete-alias]")) {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.deleteAlias!;
      const label = btn.dataset.deleteLabel ?? id;
      if (!window.confirm(`「${label}」を剥がしますか？`)) return;
      btn.disabled = true;
      const res = await fetch(`/api/admin/aliases?id=${encodeURIComponent(id)}`, {
        method: "DELETE",
      });
      if (res.ok) {
        window.location.reload();
      } else {
        btn.disabled = false;
        window.alert(`削除失敗: ${res.status} ${await res.text()}`);
      }
    });
  }
</script>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    letter-spacing: 0.12em;
  }
  .lede {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.85;
    max-width: 44rem;
  }
  .lede code {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88em;
    color: var(--color-mist-100);
  }

  .card {
    margin-bottom: 1.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--border-base);
    border-radius: 10px;
    background: rgba(184, 149, 64, 0.03);
  }
  .card h2 {
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-gold-300);
    margin: 0 0 1rem;
  }

  .add-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    align-items: end;
  }
  @media (max-width: 640px) {
    .add-form { grid-template-columns: 1fr; }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field .label {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .field input,
  .field select {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: inherit;
    /* iOS auto-zoom 抑止のため 16px 以上 */
    font-size: 1rem;
    padding: 0.5rem 0.7rem;
  }
  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--color-gold-500);
  }
  .field .hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .actions {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }
  .status {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .btn {
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-gold-700);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .btn-primary {
    background: var(--color-gold-700);
    color: var(--color-gold-100);
    border-color: var(--color-gold-500);
  }
  .btn-primary:hover {
    background: var(--color-gold-500);
    color: var(--color-ink-950);
  }
  .btn-danger {
    background: transparent;
    color: var(--color-crimson-300);
    border-color: var(--color-crimson-700);
  }
  .btn-danger:hover {
    background: rgba(193, 40, 58, 0.1);
    border-color: var(--color-crimson-500);
  }

  .table-scroll {
    overflow-x: auto;
    /* iOS スクロール慣性 */
    -webkit-overflow-scrolling: touch;
  }
  .alias-table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .alias-table th,
  .alias-table td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid rgba(184, 149, 64, 0.08);
    text-align: left;
  }
  .alias-table th {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .alias-table code.alias {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 3px;
    padding: 0.05rem 0.4rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85em;
    color: var(--color-gold-100);
  }
  .alias-table .mono {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .cell-action { text-align: right; }
  .empty {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
