---
/**
 * /calendar — カレンダー（Almanac、実データ）
 *
 * calendar_events テーブルのイベントを月暦 + アジェンダで表示。
 * 月のイベントは GET /api/calendar/events?year=&month= から取得し、
 * クライアントがグリッド/アジェンダを描画する（月送りもこれで更新）。
 *
 * 管理者（admin）はセルの「＋」やイベントのクリックで編集モーダルを開き、
 * 作成 / 更新 / 削除ができる（POST/PATCH/DELETE /api/calendar/events）。
 * 非管理者は閲覧のみ。
 */

import LuxelShell from "../layouts/LuxelShell.astro";
import { createDb } from "@ayakashi/db/client";
import { getEnv } from "../lib/auth/helpers";
import { getMemberRoleAliases } from "../lib/repos/membership";
import { isAdmin } from "../lib/auth/permissions";

if (!Astro.locals.session) {
  return Astro.redirect("/login");
}

const env = getEnv(Astro.locals);
const db = createDb(env.DATABASE_URL);
const userId = (Astro.locals.session.user as { id?: string } | undefined)?.id;
const aliases = userId ? await getMemberRoleAliases(db, userId) : [];
const userIsAdmin = isAdmin(aliases);
---

<LuxelShell title="LUXEL — カレンダー" active="calendar" isAdmin={userIsAdmin}>
  <div class="page page-wide page-in" data-admin={userIsAdmin ? "1" : "0"}>
    <header class="phead">
      <div class="eyebrow">Almanac</div>
      <h1 class="ptitle">カレンダー</h1>
      <div class="psub">the gatherings to come</div>
      <div class="phead-rule"></div>
    </header>

    <div class="cal-top">
      <div class="cal-month" data-cal-month></div>
      <div class="cal-actions">
        {userIsAdmin && (
          <button class="cal-add" data-cal-add>＋ 集いを記す</button>
        )}
        <div class="cal-nav">
          <button class="cal-btn" data-cal-prev aria-label="前の月">‹</button>
          <button class="cal-btn" data-cal-today aria-label="今月">●</button>
          <button class="cal-btn" data-cal-next aria-label="次の月">›</button>
        </div>
      </div>
    </div>

    <div class="cal-grid-wrap">
      <div class="cal-grid" data-cal-grid></div>
    </div>

    <div class="agenda agenda-side">
      <div class="agenda-h" data-agenda-h>今月の集い</div>
      <div data-agenda-list></div>
    </div>
  </div>

  {userIsAdmin && (
    <div class="cal-modal-scrim" data-modal-scrim hidden>
      <div class="cal-modal" role="dialog" aria-modal="true" aria-labelledby="cal-modal-title">
        <div class="cal-modal-head">
          <h2 id="cal-modal-title" data-modal-title>集いを記す</h2>
          <button class="cal-modal-x" data-modal-close aria-label="閉じる">×</button>
        </div>
        <form class="cal-form" data-modal-form>
          <label class="cf-field">
            <span class="cf-label">題</span>
            <input type="text" name="title" maxlength="120" required placeholder="例: 新月の観測会" />
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">日付</span>
              <input type="date" name="date" required />
            </label>
            <label class="cf-field cf-time">
              <span class="cf-label">時刻</span>
              <input type="time" name="time" />
            </label>
          </div>

          <label class="cf-check">
            <input type="checkbox" name="allDay" />
            <span>終日（時刻なし）</span>
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">繰り返し</span>
              <select name="recurrence">
                <option value="none">なし（単発）</option>
                <option value="weekly">毎週</option>
                <option value="monthly">毎月</option>
              </select>
            </label>
            <label class="cf-field cf-until" data-cf-until hidden>
              <span class="cf-label">終了日（任意）</span>
              <input type="date" name="recurrenceUntil" />
            </label>
          </div>
          <div class="cf-recur-hint" data-recur-hint hidden></div>

          <label class="cf-field">
            <span class="cf-label">区分</span>
            <input type="text" name="category" list="cal-cats" maxlength="24" placeholder="定例 / 雑談 / 大集会 / システム" />
            <datalist id="cal-cats">
              <option value="定例"></option>
              <option value="雑談"></option>
              <option value="大集会"></option>
              <option value="システム"></option>
            </datalist>
          </label>

          <label class="cf-field">
            <span class="cf-label">説明</span>
            <textarea name="description" maxlength="500" rows="3" placeholder="集いの概要や集合場所など"></textarea>
          </label>

          <label class="cf-check">
            <input type="checkbox" name="highlight" />
            <span>大きな集いとして強調（暖色）</span>
          </label>

          <div class="cf-status" data-modal-status></div>
          <div class="cf-actions">
            <button type="button" class="cf-delete" data-modal-delete hidden>削除</button>
            <span class="cf-spacer"></span>
            <button type="button" class="cf-cancel" data-modal-close>取消</button>
            <button type="submit" class="cf-save">記す</button>
          </div>
        </form>
      </div>
    </div>
  )}

  <script>
    type Recurrence = "none" | "weekly" | "monthly";
    interface ApiEvent {
      id: string;
      title: string;
      year: number;
      month: number;
      day: number;
      time: string | null;
      allDay: boolean;
      category: string | null;
      description: string | null;
      highlight: boolean;
      recurrence: Recurrence;
      /** シリーズ起点の日付（YYYY-MM-DD, JST）— 編集フォーム用 */
      seriesDate: string;
      /** シリーズ終端（YYYY-MM-DD）or null */
      recurrenceUntil: string | null;
    }

    const root = document.querySelector<HTMLElement>(".page[data-admin]");
    const isAdmin = root?.dataset.admin === "1";

    const grid = document.querySelector<HTMLElement>("[data-cal-grid]")!;
    const monthEl = document.querySelector<HTMLElement>("[data-cal-month]")!;
    const agendaH = document.querySelector<HTMLElement>("[data-agenda-h]")!;
    const agendaList = document.querySelector<HTMLElement>("[data-agenda-list]")!;

    const MONTHS_JP = ["睦月", "如月", "弥生", "卯月", "皐月", "水無月", "文月", "葉月", "長月", "神無月", "霜月", "師走"];
    const DOWS = ["日", "月", "火", "水", "木", "金", "土"];

    const today = new Date();
    let cursor = new Date(today.getFullYear(), today.getMonth(), 1);
    let events: ApiEvent[] = [];

    function esc(s: string): string {
      return String(s).replace(/[&<>"]/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!,
      );
    }

    async function load() {
      const year = cursor.getFullYear();
      const month = cursor.getMonth() + 1;
      try {
        const res = await fetch(`/api/calendar/events?year=${year}&month=${month}`, {
          credentials: "same-origin",
        });
        events = res.ok ? ((await res.json()).events as ApiEvent[]) : [];
      } catch {
        events = [];
      }
      render();
    }

    function render() {
      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      const firstDow = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const isThisMonth = year === today.getFullYear() && month === today.getMonth();

      monthEl.innerHTML =
        esc(MONTHS_JP[month]!) +
        `<span class="yr">${year} · ${String(month + 1).padStart(2, "0")}</span>`;

      // group events by day
      const byDay = new Map<number, ApiEvent[]>();
      for (const ev of events) {
        const arr = byDay.get(ev.day) ?? [];
        arr.push(ev);
        byDay.set(ev.day, arr);
      }

      let html = "";
      DOWS.forEach((w, i) => {
        const cls = i === 0 ? " sun" : i === 6 ? " sat" : "";
        html += `<div class="cal-dow${cls}">${w}</div>`;
      });
      for (let i = 0; i < firstDow; i++) html += '<div class="cal-cell empty"></div>';
      for (let d = 1; d <= daysInMonth; d++) {
        const isToday = isThisMonth && d === today.getDate();
        const evs = byDay.get(d) ?? [];
        html += `<div class="cal-cell${isToday ? " today" : ""}${isAdmin ? " editable" : ""}" data-day="${d}">`;
        html += `<span class="dn">${d}</span>`;
        html += `<span class="moon" style="opacity:${d % 7 === 6 ? 0.9 : 0.35}"></span>`;
        for (const ev of evs) {
          const recur = ev.recurrence !== "none" ? '<span class="ev-recur" aria-hidden="true">↻</span>' : "";
          html += `<div class="cal-ev${ev.highlight ? " warm" : ""}" data-ev-id="${ev.id}">${recur}${esc(ev.title)}</div>`;
        }
        if (isAdmin) html += '<span class="cal-cell-add" aria-hidden="true">＋</span>';
        html += "</div>";
      }
      grid.innerHTML = html;

      // agenda (sorted by day then time)
      const sorted = [...events].sort(
        (a, b) => a.day - b.day || (a.time ?? "").localeCompare(b.time ?? ""),
      );
      agendaH.textContent = `今月の集い · ${sorted.length} 件`;
      let al = "";
      for (const ev of sorted) {
        const dow = DOWS[new Date(year, month, ev.day).getDay()]!;
        const timeLabel = ev.allDay ? "終日" : ev.time ?? "";
        al += `<div class="agenda-row${isAdmin ? " editable" : ""}" data-ev-id="${ev.id}">`;
        al += `<div class="agenda-date"><div class="d">${ev.day}</div><div class="w">${dow}</div></div>`;
        al += '<div class="agenda-body">';
        al += `<div class="agenda-time">${esc(timeLabel)}</div>`;
        al += `<div class="agenda-title"${ev.highlight ? ' style="color:var(--warm-200)"' : ""}>${esc(ev.title)}</div>`;
        if (ev.description) al += `<div class="agenda-meta">${esc(ev.description)}</div>`;
        if (ev.category) al += `<span class="agenda-chip">${esc(ev.category)}</span>`;
        if (ev.recurrence !== "none") {
          al += `<span class="agenda-chip recur">↻ ${ev.recurrence === "weekly" ? "毎週" : "毎月"}</span>`;
        }
        al += "</div></div>";
      }
      agendaList.innerHTML =
        al || '<div class="agenda-empty">この月の集いはまだありません。</div>';
    }

    function shift(n: number) {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + n, 1);
      void load();
    }
    document.querySelector("[data-cal-prev]")!.addEventListener("click", () => shift(-1));
    document.querySelector("[data-cal-next]")!.addEventListener("click", () => shift(1));
    document.querySelector("[data-cal-today]")!.addEventListener("click", () => {
      cursor = new Date(today.getFullYear(), today.getMonth(), 1);
      void load();
    });

    // ─── admin: 編集モーダル ───
    if (isAdmin) {
      const scrim = document.querySelector<HTMLElement>("[data-modal-scrim]")!;
      const form = document.querySelector<HTMLFormElement>("[data-modal-form]")!;
      const titleEl = document.querySelector<HTMLElement>("[data-modal-title]")!;
      const statusEl = document.querySelector<HTMLElement>("[data-modal-status]")!;
      const deleteBtn = document.querySelector<HTMLButtonElement>("[data-modal-delete]")!;
      let editingId: string | null = null;

      function pad(n: number) {
        return String(n).padStart(2, "0");
      }
      function openModal(mode: "create" | "edit", data: Partial<ApiEvent> & { day?: number }) {
        editingId = mode === "edit" ? data.id ?? null : null;
        titleEl.textContent = mode === "edit" ? "集いを書き換える" : "集いを記す";
        deleteBtn.hidden = mode !== "edit";
        statusEl.textContent = "";
        form.reset();

        const f = form.elements as unknown as Record<
          string,
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >;
        (f.title as HTMLInputElement).value = data.title ?? "";
        const y = data.year ?? cursor.getFullYear();
        const m = (data.month ?? cursor.getMonth() + 1);
        const d = data.day ?? today.getDate();
        // 繰り返しはシリーズ起点（seriesDate）を基準に編集する。
        (f.date as HTMLInputElement).value = data.seriesDate ?? `${y}-${pad(m)}-${pad(d)}`;
        (f.time as HTMLInputElement).value = data.time ?? "21:00";
        (f.allDay as HTMLInputElement).checked = data.allDay ?? false;
        (f.category as HTMLInputElement).value = data.category ?? "";
        (f.description as HTMLTextAreaElement).value = data.description ?? "";
        (f.highlight as HTMLInputElement).checked = data.highlight ?? false;
        (f.time as HTMLInputElement).disabled = data.allDay ?? false;
        (f.recurrence as HTMLSelectElement).value = data.recurrence ?? "none";
        (f.recurrenceUntil as HTMLInputElement).value = data.recurrenceUntil ?? "";
        updateRecurUI();

        scrim.hidden = false;
        (f.title as HTMLInputElement).focus();
      }
      function closeModal() {
        scrim.hidden = true;
      }

      // 終日チェックで時刻入力を切替
      (form.elements.namedItem("allDay") as HTMLInputElement).addEventListener("change", (e) => {
        (form.elements.namedItem("time") as HTMLInputElement).disabled =
          (e.target as HTMLInputElement).checked;
      });

      // 繰り返し設定: 種別/日付に応じて終了日入力と説明文を出し分け
      const untilWrap = document.querySelector<HTMLElement>("[data-cf-until]")!;
      const recurHint = document.querySelector<HTMLElement>("[data-recur-hint]")!;
      function updateRecurUI() {
        const rec = (form.elements.namedItem("recurrence") as HTMLSelectElement).value;
        const dateVal = (form.elements.namedItem("date") as HTMLInputElement).value;
        if (rec === "none") {
          untilWrap.hidden = true;
          recurHint.hidden = true;
          return;
        }
        untilWrap.hidden = false;
        let label: string;
        if (dateVal) {
          const [yy, mo, dd] = dateVal.split("-").map(Number);
          const dow = DOWS[new Date(yy!, mo! - 1, dd!).getDay()]!;
          label =
            rec === "weekly"
              ? `毎週 ${dow}曜日 に繰り返します`
              : `毎月 ${dd} 日 に繰り返します`;
        } else {
          label = rec === "weekly" ? "毎週この曜日に繰り返します" : "毎月この日に繰り返します";
        }
        recurHint.textContent = label;
        recurHint.hidden = false;
      }
      (form.elements.namedItem("recurrence") as HTMLSelectElement).addEventListener(
        "change",
        updateRecurUI,
      );
      (form.elements.namedItem("date") as HTMLInputElement).addEventListener(
        "change",
        updateRecurUI,
      );

      // ＋追加ボタン
      document.querySelector("[data-cal-add]")?.addEventListener("click", () =>
        openModal("create", {}),
      );

      // グリッド: セル（空き）クリックで追加、イベントクリックで編集
      grid.addEventListener("click", (e) => {
        const evEl = (e.target as HTMLElement).closest<HTMLElement>(".cal-ev");
        if (evEl) {
          const ev = events.find((x) => x.id === evEl.dataset.evId);
          if (ev) openModal("edit", ev);
          return;
        }
        const cell = (e.target as HTMLElement).closest<HTMLElement>(".cal-cell.editable");
        if (cell && cell.dataset.day) openModal("create", { day: Number(cell.dataset.day) });
      });

      // アジェンダ行クリックで編集
      agendaList.addEventListener("click", (e) => {
        const row = (e.target as HTMLElement).closest<HTMLElement>(".agenda-row");
        if (!row) return;
        const ev = events.find((x) => x.id === row.dataset.evId);
        if (ev) openModal("edit", ev);
      });

      document.querySelectorAll("[data-modal-close]").forEach((b) =>
        b.addEventListener("click", closeModal),
      );
      scrim.addEventListener("click", (e) => {
        if (e.target === scrim) closeModal();
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const allDay = fd.get("allDay") === "on";
        const recurrence = String(fd.get("recurrence") ?? "none");
        const recurrenceUntil =
          recurrence === "none"
            ? null
            : String(fd.get("recurrenceUntil") ?? "").trim() || null;
        const payload = {
          title: String(fd.get("title") ?? "").trim(),
          date: String(fd.get("date") ?? ""),
          time: allDay ? null : String(fd.get("time") ?? ""),
          allDay,
          category: String(fd.get("category") ?? "").trim() || null,
          description: String(fd.get("description") ?? "").trim() || null,
          highlight: fd.get("highlight") === "on",
          recurrence,
          recurrenceUntil,
        };
        statusEl.textContent = "保存中…";
        const url = editingId
          ? `/api/calendar/events/${editingId}`
          : "/api/calendar/events";
        const res = await fetch(url, {
          method: editingId ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          statusEl.textContent = `失敗: ${res.status} ${await res.text()}`;
          return;
        }
        closeModal();
        await load();
      });

      deleteBtn.addEventListener("click", async () => {
        if (!editingId) return;
        const target = events.find((x) => x.id === editingId);
        const msg =
          target && target.recurrence !== "none"
            ? "この繰り返しの集いをシリーズごと消しますか？"
            : "この集いを消しますか？";
        if (!window.confirm(msg)) return;
        const res = await fetch(`/api/calendar/events/${editingId}`, { method: "DELETE" });
        if (!res.ok) {
          statusEl.textContent = `削除失敗: ${res.status}`;
          return;
        }
        closeModal();
        await load();
      });
    }

    void load();
  </script>

  <style>
    .cal-actions { display: flex; align-items: center; gap: 12px; }
    .cal-add {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      color: var(--star-200);
      background: rgba(122, 162, 255, 0.06);
      border: 1px solid var(--hair);
      border-radius: 9px;
      padding: 9px 14px;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .cal-add:hover { background: rgba(122, 162, 255, 0.12); border-color: var(--star-400); color: var(--star-050); }

    .cal-cell.editable { cursor: pointer; }
    .cal-cell.editable .cal-cell-add {
      position: absolute;
      bottom: 6px; right: 8px;
      font-family: var(--mono);
      font-size: 13px;
      color: var(--star-300);
      opacity: 0;
      transition: opacity 0.2s;
      pointer-events: none;
    }
    .cal-cell.editable:hover .cal-cell-add { opacity: 0.7; }
    .cal-cell.editable:hover { border-color: var(--hair); background: rgba(122, 162, 255, 0.05); }
    .cal-ev { cursor: inherit; }
    .cal-cell.editable .cal-ev:hover { box-shadow: 0 0 0 1px var(--star-400); }
    .agenda-row.editable { cursor: pointer; border-radius: 8px; transition: background 0.2s; }
    .agenda-row.editable:hover { background: rgba(122, 162, 255, 0.05); }
    .agenda-empty { color: var(--silver-700); font-size: 14px; padding: 18px 0; }
    .ev-recur { opacity: 0.65; margin-right: 3px; font-size: 0.85em; }
    .agenda-chip.recur {
      margin-left: 6px;
      color: var(--star-200);
      border-color: var(--star-400);
    }

    /* ── 編集モーダル（LUXEL 調） ── */
    .cal-modal-scrim {
      position: fixed; inset: 0; z-index: 60;
      background: rgba(4, 6, 15, 0.72);
      backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .cal-modal-scrim[hidden] { display: none; }
    .cal-modal {
      width: min(440px, 100%);
      max-height: 88vh;
      overflow-y: auto;
      background: linear-gradient(180deg, rgba(10, 16, 38, 0.96), rgba(7, 11, 30, 0.96));
      border: 1px solid var(--hair);
      border-radius: 16px;
      box-shadow: 0 0 40px rgba(47, 71, 168, 0.25), 0 20px 60px rgba(0, 0, 0, 0.5);
      animation: calModalIn 0.3s var(--ease);
    }
    @keyframes calModalIn { from { transform: translateY(10px); } to { transform: none; } }
    .cal-modal-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 22px 14px;
      border-bottom: 1px solid var(--hair-soft);
    }
    .cal-modal-head h2 {
      font-family: var(--serif); font-weight: 600; font-size: 18px;
      letter-spacing: 0.06em; color: var(--star-050); margin: 0;
    }
    .cal-modal-x {
      background: none; border: 0; color: var(--silver-500);
      font-size: 22px; line-height: 1; cursor: pointer; padding: 0 4px;
    }
    .cal-modal-x:hover { color: var(--star-100); }

    .cal-form { padding: 18px 22px 22px; display: flex; flex-direction: column; gap: 14px; }
    .cf-row { display: flex; gap: 12px; }
    .cf-row .cf-field { flex: 1; }
    .cf-time { max-width: 130px; }
    .cf-field { display: flex; flex-direction: column; gap: 6px; }
    .cf-label {
      font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--star-400);
    }
    .cf-field input,
    .cf-field textarea,
    .cf-field select {
      background: rgba(4, 6, 15, 0.5);
      border: 1px solid var(--hair);
      border-radius: 8px;
      color: var(--star-100);
      font-family: var(--sans);
      font-size: 14px;
      padding: 9px 11px;
      outline: none;
    }
    .cf-field select { cursor: pointer; }
    .cf-field select option { background: #0a1026; color: var(--star-100); }
    .cf-field input:focus,
    .cf-field textarea:focus,
    .cf-field select:focus { border-color: var(--star-400); }
    .cf-recur-hint {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--star-300);
      margin-top: -6px;
    }
    .cf-recur-hint[hidden] { display: none; }
    .cf-until[hidden] { display: none; }
    .cf-field textarea { resize: vertical; }
    .cf-field input[disabled] { opacity: 0.4; }
    .cf-check {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; color: var(--ink-body); cursor: pointer;
    }
    .cf-check input { accent-color: var(--star-400); width: 15px; height: 15px; }
    .cf-status { font-size: 12px; color: var(--warm-300); min-height: 1em; }
