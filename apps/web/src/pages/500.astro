---
/**
 * 500 — 霧が立ち込めて見通せません
 *
 * SSR ルート内で例外が発生したときに Astro が自動的に表示する。
 * Astro.props.error にスタックトレースが入るが、本番ではユーザーに見せない。
 */

import "../styles/global.css";

const session = Astro.locals.session;
const homeHref = session ? "/" : "/login";
const homeLabel = session ? "ハブへ戻る" : "参拝へ戻る";

// dev では原因が見やすいよう error の概要を出す
const error = Astro.props.error as Error | undefined;
const isDev = import.meta.env.DEV;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>霧が立ち込めて見通せません — 妖ポータル</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap"
    />
  </head>
  <body>
    <main class="scene">
      <div class="fog" aria-hidden="true"></div>
      <span class="kanji" aria-hidden="true">霧</span>
      <h1>霧が立ち込めて見通せません</h1>
      <p class="lede">
        一時、座敷の灯りが揺らぎました。<br />
        少し時を置き、再び訪ねられませ。
      </p>
      <a class="home" href={homeHref}>{homeLabel}</a>

      {isDev && error && (
        <details class="dev-detail">
          <summary>開発者向け詳細</summary>
          <pre>{error.message}{"\n\n"}{error.stack}</pre>
        </details>
      )}
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--bg-base);
    color: var(--text-primary);
    font-family: "Yuji Syuku", serif;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .scene {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 3rem 2rem;
    max-width: 32rem;
    text-align: center;
    z-index: 1;
  }

  .fog {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse at 50% 35%,
      rgba(184, 202, 216, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .kanji {
    font-size: clamp(7rem, 18vw, 11rem);
    line-height: 1;
    color: var(--color-ink-700);
    text-shadow: 0 0 80px rgba(184, 202, 216, 0.15);
    margin-bottom: -1rem;
  }

  h1 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    letter-spacing: 0.18em;
    margin: 0;
  }

  .lede {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.95;
    margin: 0;
  }

  .home {
    margin-top: 1rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--color-gold-700);
    border-radius: 999px;
    color: var(--color-gold-100);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .home:hover {
    background: rgba(184, 149, 64, 0.1);
    border-color: var(--color-gold-500);
  }

  .dev-detail {
    margin-top: 2rem;
    width: 100%;
    text-align: left;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .dev-detail summary {
    cursor: pointer;
    margin-bottom: 0.5rem;
  }
  .dev-detail pre {
    background: rgba(10, 5, 9, 0.5);
    border: 1px solid var(--border-base);
    border-radius: 4px;
    padding: 0.75rem;
    overflow-x: auto;
    white-space: pre-wrap;
    font-family: "JetBrains Mono", monospace;
  }
</style>
